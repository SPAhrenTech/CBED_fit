Function VaryParams()


	string sPrevF=GetDataFolder(1)
	SetDataFolder $"root:Heap"

	string sRootAnalyP=GetRootObjectPath(12)

	string sP
	variable iAnalyK,iAnaly=GetGroupDef(12,iAnalyK)
	if(iAnaly<0)
		sP=sRootAnalyP+"default:"
	else	
		sP=GetObjectPath(12,iAnalyK)
	endif
	

	Print "-----------\r"
	wave wInfoV=$sP+"infoVal"	
	wave wParV=$sP+"parVal"

	//Calculate()	

	Variable nParam=MakeParamsLists()
	
	Variable nIters=wParV[0]
	
	Make/D/O/N=(nParam) $"param0Vect"/WAVE=wParam0V
	Make/D/O/N=(nParam) $"param1Vect"/WAVE=wParam1V
	Make/D/O/N=(nParam) $"param2Vect"/WAVE=wParam2V

	Make/D/O/N=(nParam) $"dParamVect"/WAVE=wdParamV
	Make/D/O/N=(nParam) $"parInc1Vect"/WAVE=wParInc1V
	Make/D/O/N=(nParam) $"parTolVect"/WAVE=wParTolV
	Make/D/O/N=(nParam)$"parInc2Vect"/WAVE=wParInc2V


	Variable i,j
	for(i=0;i<nParam;i+=1)
		wParTolV[i]=GetParamTol(i)
		wdParamV[i]=wParTolV[i]
	endfor
	
	Variable nData=GetTotalDataPoints()
	//GetParams(wParamV)

//
	Make/D/O/N=(nData,nParam) $"JMat"/WAVE=wJM
	Make/D/O/N=(nParam,nData) $"JIMat"/WAVE=wJIM	
	Make/D/O/N=(nData) $"FOMVect"/WAVE=wFOMV
	Make/D/O/N=(nData) $"FOM1Vect"/WAVE=wFOM1V
	Make/D/O/N=(nData) $"FOM2Vect"/WAVE=wFOM2V
	
	Variable FOM0,FOM1,FOM2

	Variable lambda=0.1

	Variable iter=0
	Variable done=0
	Variable FOM
	
	if(wInfoV[0]==3)
		done=1
	endif	

	wInfoV[0]=2
	wInfoV[1]=nData
	wInfoV[2]=nParam
	wInfoV[4]=1
	DrawAnalyPanel(1,1)
	//DoUpdate
	do		

		GetParamVals(wParam0V)		
		FOM=GetFOMV(wParam0V,wFOMV)
		GetJM(wParam0V,wdParamV,wJM)

//test
		Make/D/O/N=(nData) $"dFVect"/WAVE=wdFV
		Make/D/O/N=(nParam) $"magDFVect"/WAVE=wMagDFV

		Variable imagDFMax
		Variable magDFMax=-1
		for(i=0;i<nParam;i+=1)
			wdFV[]=wJM[p][i]		
			wMagDFV[i]=norm(wdFV)
			if(wMagDFV[i]>magDFMax)
				magDFMax=wMagDFV[i]
				imagDFMax=i
			endif
		endfor
	
		Variable isBadParam=0
		if(magDFMax/nData<1.e-12)
			print "Converged."
			isBadParam=0
			done=1
			break
		endif
		for(i=0;i<nParam;i+=1)
			if(wMagDFV[i]/magDFMax<1.e-12)
				printf "No dependence on parameter: "
				ShowParam(i)
				isBadParam=1
				done=1
			endif
		endfor
		if(done)
			break
		endif

//proceed
		Variable got1=0,got2=0
		if(MatrixDampedPseudoInverseLeft(wJM,lambda))
			wave wMRes=M_result
			wJIM=wMRes			
			MatrixMultiply wJIM,wFOMV
			wave wMProd=M_product
			wParInc1V=-wMProd
			wParam1V=wParam0V+wParInc1V

			FOM1=GetFOMV(wParam1V,wFOM1V)	
			
			got1=1
		endif	

		if(MatrixDampedPseudoInverseLeft(wJM,lambda/2))
			wave wMRes=M_result
			wJIM=wMRes
			MatrixMultiply wJIM,wFOMV
			wParInc2V=-wMProd
			wParam2V=wParam0V+wParInc2V
			FOM2=GetFOMV(wParam2V,wFOM2V)	
			got2=1
		endif
		
		variable dp
		if(got1&&got2)			
			if((FOM1<FOM)||(FOM2<FOM))
				if(FOM1<FOM2)			
					wParam0V=wParam1V
					//wdParamV=FOM1/wMagDFV/1e6//test
					dp=FOM1/magDFMax/1e6
					wdParamV=(wParTolV[p]>dp)?wParTolV[p]:dp//test
					//wdParamV=wParInc1V/100
					FOM=FOM1
				else
					wParam0V=wParam2V
					//wdParamV=FOM2/wMagDFV/1e6//test
					dp=FOM2/magDFMax/1e6
					wdParamV=(wParTolV[p]>dp)?wParTolV[p]:dp//test
					//wdParamV=wParInc2V/100//need to establish a minimum here
					FOM=FOM2
					lambda/=2
				endif
			else
				lambda*=10
				//wdParamV=FOM/wMagDFV/1e6//test
				dp=FOM/magDFMax/1e6
				wdParamV=(wParTolV[p]>dp)?wParTolV[p]:dp//test
				//wdParamV/=10
			endif
		else		
			done=1	
		endif	
		//wdParamV[]=wdParamV[p]<wSigV
		SetParamVals(wParam0V,{-1})
		DoUpdate
		iter+=1

		//GetDelRSimAll()
		//VerifyAll()
		//UpdateAll()
		//UpdateObject(iGroupK,iObjectK,status)
		wInfoV[3]=FOM
		wInfoV[4]=iter
		DrawAnalyPanel(0,0)
		if(GetKeyState(0)&32)	
			wInfoV[0]=3
		endif
		if (wInfoV[0]==3)
			done=1
		endif
		//DrawModelPanel(0,0)

	while(iter<nIters&&(!done))

	wInfoV[0]=3
	DrawAnalyPanel(0,0)

	//Find errors
	Make/D/O/N=(nParam) $"delParVect"/WAVE=wDelParV
	
	GetJM(wParam0V,wdParamV,wJM)
	if(MatrixCovarianceInverse(wJM))
		wave wMRes=M_result
		wDelParV[]=sqrt(wMRes[p][p])
	endif
	SetDelParams(wDelParV)	

	wInfoV[0]=0
	DrawAnalyPanel(0,0)
		
	//
	Print "Data points:",nData,"\r"
	Print "Parameters:",nParam,"\r"
	Print "Iterations:",iter,"\r"
	Print "FOM:",FOM,"\r"

	KillWaves/A/Z
	SetDataFolder $sPrevF

End

