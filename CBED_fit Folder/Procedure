Function ChangeDynArea(iDynK)
variable iDynK


	if(GetObjectIndex(9,iDynK)<0)
		return -1
	endif
	string sDynP=GetObjectPath(9,iDynK)

	wave wInfoV=$sDynP+"infoVal"
	variable yTop=wInfoV[0]
	variable xLeft=wInfoV[1]
	variable yBottom=wInfoV[2]
	variable xRight=wInfoV[3]
	
	variable xSize=abs(xRight-xLeft)+1
	variable ySize=abs(yTop-yBottom)+1
