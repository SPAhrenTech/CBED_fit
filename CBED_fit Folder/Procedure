Function FindInter(wDelR1V,wDelR2V,wPointV)			
wave wDelR1V,wDelR2V,wPointV

	Make/D/O/N=(2,2) $"numerMat",$"denomMat"
	wave wDenomM=$"denomMat"
	wave wNumerM=$"numerMat"

	Make/D/O/N=(2) $"inhomVect",$"inhomVect"
	wave wInhomV=$"inhomVect"
	
	wDenomM[0][]=wDelR1V[q]
	wDenomM[1][]=wDelR2V[q]
	variable denom=MatrixDet(wDenomM)
	
	wInhomV[0]=norm(wDelR1V)^2
	wInhomV[1]=norm(wDelR2V)^2

	wNumerM=wDenomM
	wNumerM[][0]=wInhomV[p]
	wPointV[0]=MatrixDet(wNumerM)/denom

	wNumerM=wDenomM
	wNumerM[][1]=wInhomV[p]
	wPointV[1]=MatrixDet(wNumerM)/denom	
End

