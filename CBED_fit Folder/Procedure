Function MoveObjectForward(iGroupK,iObjectK,iRefGroupK,iRefObjectK)
variable iGroupK,iObjectK,iRefGroupK,iRefObjectK

	if(GetObjectIndex(iGroupK,iObjectK)<0)
		return -1
	endif
	string sObjectP=GetObjectPath(iGroupK,iObjectK)
	wave wRefGroupK=$sObjectP+"refGroupKey"
	wave wRefObjectK=$sObjectP+"refObjectKey"
	
	variable nRef=DimSize(wRefObjectK,0)
	variable i,iRef=-1,found=0
	for(i=0;i<nRef;i+=1)
		if(wRefGroupK[i]==iRefGroupK)
			if(found)
				deletepoints iRef,1,wRefGroupK,wRefObjectK
				insertpoints i,1,wRefGroupK,wRefObjectK
				wRefGroupK[i]=iRefGroupK
				wRefObjectK[i]=iRefObjectK
				return 0
			else
				if(wRefObjectK[i]==iRefObjectK)
					iRef=i
					found=1
				endif
			endif
		endif
	endfor
	return -1
End


