Function GraphPopupMenuProc(s):PopupMenuControl
STRUCT WMPopupAction &s
	variable ecode=s.eventCode
	if(ecode==-1)
		return -1
	endif

	struct ObjectInfo sObject
	variable iGroupK,iTab,iItem,iIndex
	FindPanelControlInfo(s.win,s.ctrlName,iGroupK,iTab,iItem,iIndex,sObject)

	variable iSel=s.popNum-1
	switch(iTab)
		case -1:
		switch(iItem)
			case 0:
			SelectObject(iGroupK,iSel,1)
			break
			
			case 1:
			switch(iSel)
				case 0:
				NewObject(iGroupK)
				break
		
				case 1:
				NewTable(iGroupK,sObject.iK)
				break
		
				case 2:
				RenameObjectDlg(iGroupK,sObject.iK)
				break

				case 3:
				DoWindow/K $sObject.sN
				break
			endswitch
			AppendRefreshUpdateRefList(iGroupK,sObject.iK,1)
			break
			
		endswitch
		break
		
		case 1:
		switch(iItem)
			case 0:
			wave wValL=$sObject.sP+"valList"
			switch(iIndex)
				case 7://line
				case 10://fil
				case 14://label
				Variable iRed,iGreen,iBlue
				ConvertRGBstrToRGB(s.popstr,iRed,iGreen,iBlue)
				wValL[iIndex]=iRed;wValL[iIndex+1]=iGreen;wValL[iIndex+2]=iBlue
				break
				
				default:
				wValL[iIndex]=iSel
			endswitch
			break
			
			case 1://model			
		 	nvar vModelK=$sObject.sP+"modelKey"
			vModelK=FindObjectKey(2,iSel)
			SetGroupDefkey(2,vModelK)
			break
			
			case 2://label font		
		 	svar sLabelFontN=$sObject.sP+"labelFontName"
			sLabelFontN=s.popstr
			break
			
		endswitch
		AppendRefreshUpdateRefList(iGroupK,sObject.iK,1)
		break

	endswitch
End

