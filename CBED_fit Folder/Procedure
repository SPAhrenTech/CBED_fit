Function FindIndex(iKey,wKey)
variable iKey
wave wKey
	FindValue/Z/I=(iKey) wKey
	return V_value
End
	
//
Function CheckIndex(iKey,iIndex,wKey)
variable iKey
variable &iIndex
wave/T wKey
	Variable iVal=FindIndex(iKey,wKey)
	Variable res=0
	if(iVal>=0)
		res=1
		iIndex=iVal
	endif
	return res
End
	
//
Function GetNextKey(iKey,wKey)
variable iKey
wave wKey
	Variable iIndex
	do
		iKey+=1
		if(!CheckIndex(iKey,iIndex,wKey))
			break
		endif
		if(iKey>(10^6-1))
			iKey=0
			break
		endif
	while(1)
	return iKey
End
