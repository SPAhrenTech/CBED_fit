//
Function/T GetContainingFolder(sFolder)
string sFolder
	Variable i,j,k
	Variable nChar=strlen(sFolder)
	for(i=0;i<nChar;i+=1)
		j=nChar-i-1
		string sChar=sFolder[j]
		if(StringMatch(sChar,":"))
			k=j-1
			break
		endif
	endfor

	string res=""
	for(i=0;i<k+1;i+=1)
		res+=sFolder[i]
	endfor
	return  res
End

