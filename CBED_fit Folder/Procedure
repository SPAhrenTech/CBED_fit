Function MoveObjectBack(iGroupK,iObjectK,iRefGroupK,iRefObjectK)
variable iGroupK,iObjectK,iRefGroupK,iRefObjectK

	if(GetObjectIndex(iGroupK,iObjectK)<0)
		return -1
	endif
	string sObjectP=GetObjectPath(iGroupK,iObjectK)
	wave wRefGroupK=$sObjectP+"refGroupKey"
	wave wRefObjectK=$sObjectP+"refObjectKey"
	
	variable nRef=DimSize(wRefObjectK,0)
	variable i,iRef=-1,found_dest=0
	for(i=0;i<nRef;i+=1)
		if(wRefGroupK[i]==iRefGroupK)
			if(wRefObjectK[i]!=iRefObjectK)
				iRef=i
				found_dest=1
			else
				if(found_dest)
					deletepoints i,1,wRefGroupK,wRefObjectK
					insertpoints iRef,1,wRefGroupK,wRefObjectK
					wRefGroupK[iRef]=iRefGroupK
					wRefObjectK[iRef]=iRefObjectK
					return 0
				endif		
			endif
		endif
	endfor
	return -1
End

