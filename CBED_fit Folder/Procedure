Function SetFitDelLines(iFitK,do_add)
variable iFitK,do_add

	if(GetObjectIndex(4,iFitK)<0)
		return -1
	endif
	string sFitP=GeTObjectPath(4,iFitK)

	wave wFitInfoV=$sFitP+"infoVal"
	variable Nmin=wFitInfoV[0]
	variable Nmax=wFitInfoV[1]
	
	wave wDelL=$sFitP+"delList"

//
	nvar vExptK=$sFitP+"exptKey"
	if(GetObjectIndex(1,vExptK)<0)
		return -1
	endif	
	string sExptP=GetObjectPath(1,vExptK)

	wave whklM=$sExptP+"hklMat"	
	wave wDelRM=$sExptP+"delRMat"

//
	Make/D/O/N=(2) $"delRVect"/WAVE=wDelRV
	Make/D/O/N=(2) $"rVect"/WAVE=wRV
	Make/D/O/N=(3) $"hklVect"/WAVE=whklV

//
	nvar vModelK=$sFitP+"modelKey"	
	if(GetObjectIndex(2,vModelK)<0)
		return -1
	endif	
	string sModelP=GetObjectPath(2,vModelK)

	wave wModelParV=$sModelP+"parVal"	
	variable camlen=wModelParV[0]
	variable phi=wModelParV[1]
	variable xZone=wModelParV[2]
	variable yZone=wModelParV[3]
	variable recc=wModelParV[4]
	variable rho=wModelParV[5]
	
	wave wEccIM=$sModelP+"eccIMat"

	Make/O/D/N=(2) $"rZoneVect"/WAVE=wRZoneV
	wRZoneV={xZone,yZone}

	wave wModelInfoV=$sModelP+"infoVal"	
	variable dxBeam=wModelInfoV[4]
	variable dyBeam=wModelInfoV[5]
	variable alpha=wModelInfoV[6]

	Make/D/O/N=(2) $"rBeamVect"/WAVE=wRBeamV
	wRBeamV={xZone+dxBeam,yZone+dyBeam}

	wave wuvwzV=$sModelP+"uvwzVect"	

//
	Make/D/O/N=(2) $"delRVect"/WAVE=wDelRV
	Make/D/O/N=(2) $"rVect"/WAVE=wRV
	Make/D/O/N=(3) $"hklVect"/WAVE=whklV

	variable rad=camlen*tan(alpha/1000)
	variable nData=DimSize(wDelRM,0)
	variable i,j,k

	Redimension/N=(0) wDelL
	k=0
	for(i=0;i<nData;i+=1)
		whklV=whklM[i][p]
		variable N=DotProd(whklV,wuvwzV)
		if((N<Nmin)||(N>Nmax))
			continue
		endif
		wDelRV=wDelRM[i][p]
		TranslateDelN(wDelRV,wRBeamV)
		TransformDel(wDelRV,wEccIM)
		TranslateDel(wDelRV,wRBeamV)
		if(LineIntersectsCircle(wDelRV,wRZoneV,rad))				
			if(do_add)
				Redimension/N=(k+1) wDelL
				wDelL[k]=i
				k+=1
			endif
		endif
	endfor
End

