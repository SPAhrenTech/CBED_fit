	variable res=1
	wave wTableK=$sRootTableP+"key"
	variable nTable=DimSize(wTableK,0)
	variable iTable
	for(iTable=0;iTable<nTable;iTable+=1)	
		variable iTableK=wTableK[iTable]
		string sTableN="t"+GetKeyString(iTableK)
		string sTableP=sRootTableP+sTableN+":"
		nvar vSourceY=$sTableP+"sourceType"
