Function DrawAnalyPanelParams(sPanelN,yp)
string sPanelN
variable yp

	string sRootAnalyP=GetRootObjectPath(12)

	string sTitleBox="TitleBox"
	string sPopup="Popup"
	string sSetVar="SetVar"
	string sCheckBox="CheckBox"
	string sSlider="Slider"
	string sButton="Button"

	string sInfo="12;0"

	//
	yp+=25
	SetVariable/Z $sSetVar+"Iters",win=$sPanelN,pos={10,yp},size={120,20},mode=1,limits={0,1000,1},title="iters"

	yp+=20
	SetVariable/Z $sSetVar+"Sigpix",win=$sPanelN,pos={10,yp},size={120,20},mode=1,limits={1,1000,1},title="sig (pix)"
	
	yp+=20
	SetVariable/Z $sSetVar+"Signm",win=$sPanelN,pos={10,yp},size={120,20},mode=1,limits={1e-9,1,0.0001},title="sig (nm)"

	variable disable_state=0
	string sP
	variable iAnalyK,iAnaly=GetGroupDef(12,iAnalyK)
	if(iAnaly<0)
		sP=sRootAnalyP+"default:"
		disable_state=2
	else	
		sP=GetObjectPath(12,iAnalyK)
	endif
	
	wave wParV=$sP+"parVal"
	wave wSigV=$sP+"sigVal"
	SetVariable $sSetVar+"Iters",win=$sPanelN,value=wParV[0],proc=AnalySetVarProc,userdata(panel)=sInfo+";0;0;0"	
	SetVariable $sSetVar+"Sigpix",win=$sPanelN,value=wSigV[0],proc=AnalySetVarProc,userdata(panel)=sInfo+";1;0;0"
	SetVariable $sSetVar+"Signm",win=$sPanelN,value=wSigV[1],proc=AnalySetVarProc,userdata(panel)=sInfo+";1;1;0"

	wave wInfoV=$sP+"infoVal"
	variable nStatus,nData,nPar,FOM,iter
	nStatus=wInfoV[0]
	nData=wInfoV[1]
	nPar=wInfoV[2]
	FOM=wInfoV[3]
	iter=wInfoV[4]

	variable nIters
	nIters=wParV[0]

//
	string sMsgN=sRootAnalyP+"varyMessages"
	Make/T/O/N=(5) $sMsgN
	wave/T wMsgN=$sMsgN
	
	string sMsg=""
	wMsgN=sMsg
	switch(nStatus)
		case 0://idle
		sprintf sMsg,"data points: %4.0f",nData;wMsgN[1]=sMsg
		sprintf sMsg,"FOM: %f",FOM;wMsgN[2]=sMsg		
		break
		
		case 1://idle
		wMsgN[4]="Evaluating..."
		disable_state=2
		break

		case 2://varying
		sprintf sMsg,"parameters: %4.0f",nPar;wMsgN[0]=sMsg
		sprintf sMsg,"data points: %4.0f",nData;wMsgN[1]=sMsg
		sprintf sMsg,"FOM: %f",FOM;wMsgN[2]=sMsg
		sprintf sMsg,"Iterations: %4.0f/%4.0f",iter,nIters;wMsgN[3]=sMsg
		wMsgN[4]="Varying..."
		disable_state=2
		break
		
		case 3://finishing
		sprintf sMsg,"parameters: %4.0f",nPar;wMsgN[0]=sMsg
		sprintf sMsg,"data points: %4.0f",nData;wMsgN[1]=sMsg
		sprintf sMsg,"FOM: %f",FOM;wMsgN[2]=sMsg
		sprintf sMsg,"Iterations: %4.0f/%4.0f",iter,nIters;wMsgN[3]=sMsg
		wMsgN[4]="Finishing..."
		disable_state=2
		break
		
		case 4://calculating
		wMsgN[4]="Calculating..."
		disable_state=2
		break
		
		case 5://unresolved
		break
		
	endswitch
		
	SetVariable $sSetVar+"Iters",win=$sPanelN,disable=disable_state
	SetVariable $sSetVar+"Sigpix",win=$sPanelN,disable=disable_state
	SetVariable $sSetVar+"Signm",win=$sPanelN,disable=disable_state

	yp+=20
	TitleBox $sTitleBox+"Msg0",win=$sPanelN,anchor=LT,pos={10,yp},size={50,15},title=wMsgN[0],frame=0

	yp+=20
	TitleBox $sTitleBox+"Msg1",win=$sPanelN,anchor=LT,pos={10,yp},size={50,15},title=wMsgN[1],frame=0

	yp+=20
	TitleBox $sTitleBox+"Msg2",win=$sPanelN,anchor=LT,pos={10,yp},size={50,15},title=wMsgN[2],frame=0

	yp+=20
	TitleBox $sTitleBox+"Msg3",win=$sPanelN,anchor=LT,pos={10,yp},size={50,15},title=wMsgN[3],frame=0

	yp+=20
	TitleBox $sTitleBox+"Msg4",win=$sPanelN,anchor=LT,pos={10,yp},size={50,15},title=wMsgN[4],frame=0

End

