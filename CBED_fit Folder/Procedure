Function FindModel(iModelKey)
variable &iModelKey

	string sRootPath="root:"
	string sRootModelPath=sRootPath+"Models:"

	wave modelK=$sRootModelPath+"modelKey"
	variable nModel=DimSize(modelK,0)

	variable found_model=0
	string sDefModelKeyName=sRootModelPath+"defKey"
	nvar/Z vDefModelKey=$sDefModelKeyName
	if(!nvar_exists(vDefModelKey))
		variable/G $sDefModelKeyName
	endif	
	iModelKey=vDefModelKey
	variable iModel=FindIndex(iModelKey,modelK)
	if(iModel<0)
		variable iModelCheck=0
		do
			if(iModelCheck<nModel)
				iModelKey=modelK[iModelCheck]
				iModel=FindIndex(iModelKey,modelK)
				if(iModel<0)			
					iModelCheck+=1
				else
					found_model=1
					break
				endif
			else
				break
			endif
		while(1)
	else
		found_model=1
	endif
	vDefModelKey=iModelKey
	return iModel
end

Function DeleteObject(iGroupK,iObjectK,doDlg)
variable iGroupK,iObjectK,doDlg

	string sRootObjectP=GetRootObjectPath(iGroupK)
		
	if(doDlg)
		if(!QueryObject(iGroupK,iObjectK,"Delete"))
			return 0
		endif
	endif
		
//	
	if(GetObjectIndex(iGroupK,iObjectK)<0)
		return -1
	endif	
	string sObjectP=GetObjectPath(iGroupK,iObjectK)
//	
	
	switch(iGroupK)
		case 0:
		break
		
		case 1:
		break

		case 2:
		nvar vBeamK=$sObjectP+"beamKey"
		RemoveObjectRef(0,vBeamK,iGroupK,iObjectK)
	
		nvar vLayerK=$sObjectP+"layerKey"
		RemoveObjectRef(6,vLayerK,iGroupK,iObjectK)
		break
		
		case 3:
		nvar vModelK=$sObjectP+"modelKey"
		RemoveObjectRef(2,vModelK,iGroupK,iObjectK)
		break

		case 4:
		nvar vModelK=$sObjectP+"modelKey"
		RemoveObjectRef(2,vModelK,iGroupK,iObjectK)
		break

		case 5:
		nvar vFitK=$sObjectP+"fitKey"
		RemoveObjectRef(4,vFitK,iGroupK,iObjectK)
		break

		case 6:
		nvar vMaterK=$sObjectP+"materKey"
		RemoveObjectRef(13,vMaterK,iGroupK,iObjectK)
		break
		
		case 8:
		DeleteObjectRefGroup(8,iObjectK,11,0)
		break
		
		case 9:
		nvar vModelK=$sObjectP+"modelKey"
		RemoveObjectRef(2,vModelK,iGroupK,iObjectK)
		break

		case 11:
		RemovePlot(iObjectK)
		nvar vGraphK=$sObjectP+"graphKey"
		RemoveObjectRef(8,vGraphK,iGroupK,iObjectK)
		break

	endswitch
	
	DeleteTableFromSource(iGroupK,iObjectK)
	DeletePlotFromSource(iGroupK,iObjectK)
	return KillObject(iGroupK,iObjectK)
End

