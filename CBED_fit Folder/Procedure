Function RefreshGraph(iGraphK)
variable iGraphK

	if(GetObjectIndex(8,iGraphK)<0)
		return -1
	endif
	string sGraphP=GetObjectPath(8,iGraphK)
	string sGraphN=GetObjectName(8,iGraphK)
	nvar vS=$sGraphP+"status"

//save cursor status
	string sAcommand=StringByKey("RECREATION",CsrInfo(A,sGraphN))
	string sBcommand=StringByKey("RECREATION",CsrInfo(B,sGraphN))
	
	wave wValL=$sGraphP+"valList"
	variable iCoords=wValL[0]
	variable iScale=wValL[1]
	variable iScaleLength=wValL[2]
	variable iScaleUnits=wValL[3]
	variable iScaleAspect=wValL[4]
	variable iLineWidth=wValL[5]
	variable iFill=wValL[6]
	variable iLineRed=wValL[7]
	variable iLineGreen=wValL[8]
	variable iLineBlue=wValL[9]
	variable iFillRed=wValL[10]
	variable iFillGreen=wValL[11]
	variable iFillBlue=wValL[12]
	variable iShowLabel=wValL[13]
	variable iLabelRed=wValL[14]
	variable iLabelGreen=wValL[15]
	variable iLabelBlue=wValL[16]
	variable iFontSize=wValL[17]
	variable iAxes=wValL[18]

	svar sLabelFontN=$sGraphP+"labelFontName"

	if(iAxes)
		ModifyGraph/W=$sGraphN  axThick(left)=1,axThick(bottom)=1
	else
		ModifyGraph/W=$sGraphN  axThick(left)=0,axThick(bottom)=0
	endif	

	if(iCoords)
		ModifyGraph/W=$sGraphN  noLabel=0
	else
		ModifyGraph/W=$sGraphN noLabel=2
	endif	
	ModifyGraph/W=$sGraphN margin(left)=12+24*iCoords,margin(bottom)=12+24*iCoords,margin(right)=12,margin(top)=12

	GetAxis/Q/W=$sGraphN left
	variable xGraphLeft=V_min,xGraphRight=V_max

	GetAxis/Q/W=$sGraphN bottom
	variable yGraphTop=V_max,yGraphBottom=V_min

	variable xGraphRange=xGraphRight-xGraphLeft
	variable yGraphRange=yGraphTop-yGraphBottom

//
	do
		if(iScale)
			nvar vModelK=$sGraphP+"modelKey"
			if(GetObjectIndex(2,vModelK)<0)
				break
			endif
		
			string sModelP=GetObjectPath(2,vModelK)
			wave wModelParV=$sModelP+"parVal"
			variable L=wModelParV[0]
			
			nvar vBeamK=$sModelP+"beamKey"
			if(GetObjectIndex(0,vBeamK)<0)
				break
			endif
			
			string sBeamP=GetObjectPath(0,vBeamK)
			wave wBeamParV=$sBeamP+"parVal"
			variable E=wBeamParV[0]
			variable lambda=get_wvln(E)
			variable scale_pix
			string sunits
			switch(iScaleUnits)
				case 0:
				variable camconst=lambda*L
				scale_pix=iScaleLength*camconst
				sunits="1/nm"
				break

				case 1:
				scale_pix=iScaleLength*L/1000
				sunits="mrad"
				break
				
			endswitch
			
			string slabel=num2str(iScaleLength)+" "+sunits
			
			DrawAction/W=$sGraphN getgroup=scalebar,delete,begininsert
			SetDrawEnv/W=$sGraphN gstart,gname=scalebar
			//SetDrawEnv/W=$sGraphN origin=0,0
			SetDrawEnv/W=$sGraphN xcoord= bottom,ycoord= left
			SetDrawLayer/W=$sGraphN UserFront
			SetDrawEnv/W=$sGraphN linethick=iLineWidth
			
			SetDrawEnv/W=$sGraphN fillpat=iFill
			SetDrawEnv/W=$sGraphN linefgc=(iLineRed,iLineGreen,iLineBlue)
			SetDrawEnv/W=$sGraphN fillfgc=(iFillRed,iFillGreen,iFillBlue)
			//SetDrawEnv/W=$sGraphN fillfgc=(0,0,0)//(iFillRed,iFillGreen,iFillBlue)
			//DrawLine/W=$sGraphN 0,0,500,500
			
			variable xOffset=0.04,yOffset=0.04			
			variable xRel=scale_pix/xGraphRange
			variable yRel=xRel/iScaleAspect

			variable relTop,relLeft,relBottom,relRight
			relBottom=1-yOffset
			relLeft=xOffset
			relRight=relLeft+xRel
			relTop=relBottom-yRel/iScaleAspect

			SetDrawEnv/W=$sGraphN xcoord=prel,ycoord=prel
			DrawRect/W=$sGraphN relLeft,relTop,relRight,relBottom
			SetDrawEnv/W=$sGraphN gstop
			
			if(iShowLabel)
				DrawAction/W=$sGraphN getgroup=scalelabel,delete,begininsert
				SetDrawEnv/W=$sGraphN gstart,gname=scalelabel
				variable xMiddleRel=(relLeft+relRight)/2
				variable yBottomRel=(relTop+relBottom)/2-0.005
				SetDrawEnv/W=$sGraphN fsize=iFontSize
				//Execute "SetDrawEnv/W="+sGraphN+" fName="+sLabelFontN
				Execute "SetDrawEnv/W="+sGraphN+" fName=\""+sLabelFontN+"\""
				SetDrawEnv/W=$sGraphN textxjust=1,textyjust=0
				SetDrawEnv/W=$sGraphN textrgb=(iLabelRed,iLabelGreen,iLabelBlue)
				DrawText/W=$sGraphN xMiddleRel,yBottomRel,slabel
				SetDrawEnv/W=$sGraphN gstop
			else
				DrawAction/W=$sGraphN getgroup=scalelabel,delete
			endif
		else
			DrawAction/W=$sGraphN getgroup=scalebar,delete
			DrawAction/W=$sGraphN getgroup=scalelabel,delete
		endif
		break
	while(1)	

	DoUpdate/W=$sGraphN
	
	Execute/Q/Z sACommand
	Execute/Q/Z sBCommand
End

