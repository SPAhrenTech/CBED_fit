Function GraphWindowHook(s)
struct WMWinHookStruct &s

	Variable hookResult = 0
	string sRootP="root:"

	string sGraphN=s.winname
	variable iGraphK
	if(GetObjectIndexFromName(8,sGraphN,iGraphK)<0)
		return hookResult 
	endif
			
	string sGraphP=GetObjectPath(8,iGraphK)
	string sModelP
	//string event= StringByKey("EVENT",s)
	//Print s.eventCode
	switch(s.eventCode)
		case 0:				//activate
		hookResult = 0
		if(SetGroupDefkey(8,iGraphK)<0)
			return -1
		endif

		nvar vDefPlotK=$sGraphP+"defPlotKey"
		SetGroupDefkey(11,vDefPlotK)
		
		DrawAllPanels()
		break


		case 2:				// Kill
		hookResult = 1
		DeleteObject(8,iGraphK,0)
		DrawAllPanels()
		break

		case 3:				// MouseDown
		if(GetKeyState(0)&4)	//shift pressed
			StartGraphDrag(iGraphK,s.mouseLoc.h,s.mouseLoc.v)
			hookResult = 1
		endif
		break

		case 4:				// Cursor moved
		if((GetKeyState(0)&4)&&(s.eventMod&1))	//shift pressed
			DragGraph(iGraphK,s.mouseLoc.h,s.mouseLoc.v)
		hookResult=1
		else
			//RestoreDragGraph(iGraphK)
		endif
		//DrawGraphPanel(0,0)
		break

		case 5:				// MouseUp
		if(GetKeyState(0)&4)	//shift pressed
			//EndDragGraph(iGraphK,s.mouseLoc.h,s.mouseLoc.v)
		else
			//RestoreDragGraph(iGraphK)
		endif
		hookResult = 1
		break
		
		case 17:				// KillVote
		hookResult=1
		if(!QueryObject(8,iGraphK,"Delete"))
			hookResult=2
		endif
		break

	endswitch

	return hookResult		// 0 if nothing done, else 1
End

