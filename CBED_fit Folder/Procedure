Function/T GetAlphaNumChar(iChar)
Variable iChar
	if((0<=iChar)&&(iChar<10))
		return num2char(iChar+48)
	endif
	return ""
End

Function GetAlphaCharNum(sChar)
string sChar
	variable iChar=char2num(sChar)-48
	if((0<=iChar)&&(iChar<10))
		return iChar
	endif
	return -1
End

