Function GetDelKV(wGV,lambda,is_excess,wDelKV)
wave wGV
variable lambda,is_excess
wave wDelKV

	Variable g=Norm(wGV)
	
	Variable k=1/lambda
	Variable kz=k*cos(asin(g/2/k)-asin(wGV[2]/g))//closest approach	

	variable num=wGV[2]*kz-(g^2)/2
	Variable kxi=num/wGV[0]
	Variable kyi=num/wGV[1]

	//Printf "kxi,kyi: (%5.3f ,%5.3f) nm^-1\r",kxi,kyi
	Variable kDel=1/sqrt(1/kxi^2+1/kyi^2)
	wDelKV[0]=kDel^2/kxi
	wDelKV[1]=kDel^2/kyi
	if(is_excess)
		wDelKV[0]+=wGV[0]
		wDelKV[1]+=wGV[1]
	endif
End

