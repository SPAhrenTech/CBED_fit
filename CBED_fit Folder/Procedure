	if((!((ecode==1)||(ecode==2)))||(ecode==-1))
		return -1
	endif

	struct ObjectInfo sObject
	variable iGroupK,iTab,iItem,iIndex
	FindPanelControlInfo(s.win,s.ctrlName,iGroupK,iTab,iItem,iIndex,sObject)

	switch(iTab)
	
		case 0:
		switch(iItem)
			case 0:
			wave wInfoV=$sObject.sP+"infoVal"
			wInfoV[iIndex]=s.dval
				
			variable yTop=wInfoV[0]
			variable xLeft=wInfoV[1]
			variable yBottom=wInfoV[2]
			variable xRight=wInfoV[3]
			variable thickness_nm=wInfoV[4]
			variable resolution=wInfoV[5]

			if(thickness_nm<0)
				 thickness_nm=0
			endif

			if(yTop<yBottom+1)
				yBottom=yTop-1
			endif
			
			if(xLeft>xRight-1)
				xRight=xLeft+1
			endif

			if(yBottom>yTop-1)
				yTop=yBottom+1
			endif

			if(xRight<xLeft+1)
				xLeft=xRight-1
			endif

			if(resolution<=0)
				resolution=1
			endif
			
			wInfoV[0]=ceil(yTop)
			wInfoV[1]=floor(xLeft)
			wInfoV[2]=floor( yBottom)
			wInfoV[3]=ceil(xRight)
			wInfoV[4]=thickness_nm
			wInfoV[5]=resolution
			ChangeDynArea(sObject.iK)
			UpgradeObjectStatus(iGroupK,sObject.iK,1)
			break
			
