Function get_comp_y_GaInPAs(a1,a2,a3,xc)
Variable a1,a2,a3,xc
	
	Variable yc=0.5
	variable tol=1e-5,maxiter=1000

	Variable apara=(a1+a2)/2;
	Variable aperp=a3;
		
	variable ax0=get_a_nm_GaInPAs(xc,0)
	variable ax1=get_a_nm_GaInPAs(xc,1)
	
	Variable i
	for(i=0;i<=maxiter;i=i+1)	
		variable yc0=yc
		Variable C=2*get_c12_GaInPAs(xc,yc)/get_c11_GaInPAs(xc,yc);//
		Variable ap=(aperp+C*apara)/(1.+C);
		yc=(ap-ax0)/(ax1-ax0);		
		if(abs(yc-yc0)<tol) 
			return xc
		endif
	endfor
	
	return yc
End

