Function MakeDynhklMat(iDynK)
variable iDynK

	if(GetObjectIndex(9,iDynK)<0)
		return -1
	endif
	string sDynP=GetObjectPath(10,iDynK)
	
	variable iAnalyK=GetGroupDefKey(12)
