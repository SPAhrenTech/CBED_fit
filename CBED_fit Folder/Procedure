Function DoesIntersectRect(delrV,yTop,xLeft,yBottom,xRight)
wave delrV
Variable yTop,xLeft,yBottom,xRight
		
	Variable delr=norm(delrV)
	Variable a=delrV[0]/delr^2
	Variable b=delrV[1]/delr^2
			
	Variable xtop=(1-b*ytop)/a
	Variable xbottom=(1-b*ybottom)/a
	Variable yleft=(1-a*xleft)/b
	Variable yright=(1-a*xright)/b
			
	if((xtop>=xleft)&&(xtop<=xright))
		return 1
	endif
			
	if((yleft>=ybottom)&&(yleft<=ytop))
		return 1
	endif

	if((xbottom>=xleft)&&(xbottom<=xright))
		return 1
	endif

	if((yright>=ybottom)&&(yright<=ytop))
		return 1
	endif

	return 0
End

