Function MatrixCovarianceInverse(wM)
wave wM
Variable lambda

	Duplicate /O wM,$"MT"
	wave wMT=$"MT"
	MatrixTranspose wMT
	MatrixMultiply wMT,wM

	Variable det=MatrixDet(M_product)
	Variable mtrace=MatrixTrace(M_product)
	if(mtrace==0)
		return 0
	endif
	Variable tol=1e-24
	Variable nSize=DimSize(M_product,0)
	Variable tdet=abs(det)^(1/nSize)
	if(abs(tdet/mtrace)<tol)
		return 0//not invertible
	endif

	MatrixInverse M_product		
	Duplicate /O M_inverse,$"M_result"
	KillWaves wMT
	return 1//inverted
end

