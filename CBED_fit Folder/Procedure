Function AppendUpdateList(iGroupK,iObjectK)
variable iGroupK,iObjectK
	string sRootP="root:"
	string sRootUpdateP=sRootP+"Updates:"

	wave wGroupK=$sRootUpdateP+"groupKey"	
	wave wObjectK=$sRootUpdateP+"objectKey"
	wave wLevelL=$sRootUpdateP+"levelList"
	
	variable nUpdate=DimSize(wGroupK,0)
	variable i,j
	for(i=0;i<nUpdate;i+=1)
		if((wGroupK[i]==iGroupK)&&(wObjectK[i]==iObjectK))
			return 0
		endif
	endfor

	string sObjectP=GetObjectPath(iGroupK,iObjectK)
	wave wRefGroupK=$sObjectP+"refGroupKey"
	wave wRefObjectK=$sObjectP+"refObjectKey"
	variable nRef=DimSize(wRefGroupK,0)
	
	variable do_insert=0
	for(i=0;i<nUpdate;i+=1)
		for(j=0;j<nRef;j+=1)
			if((wGroupK[i]==wRefGroupK[j])&&(wObjectK[i]==wRefObjectK[j]))
				do_insert=1
				break
			endif
		endfor
		if(do_insert)
			break
		endif
	endfor
	insertpoints i,1,wGroupK,wObjectK,wLevelL
	wGroupK[i]=iGroupK
	wObjectK[i]=iObjectK
	//wLevelL[i]=GetGroupLevel(iGroupK)
	//Sort wLevelL,wGroupK,wObjectK,wLevelL
End

