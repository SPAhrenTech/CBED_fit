	SetScale/I y yBottom,yTop,"",wDynC
	SetScale/I x xLeft,xRight,"",wDynC
End

//
Function RefreshDyn(iDynK)
variable iDynK

	string sRootCnstnP="root:Constants:"
	string sPrevF=GetDataFolder(1)
	SetDataFolder $"root:Heap"

	if(GetObjectIndex(9,iDynK)<0)
		return -1
	endif
	string sDynP=GetObjectPath(9,iDynK)
	nvar vS=$sDynP+"status"
	if(vS<4)
		return 0
	endif

	wave wDynInfoV=$sDynP+"infoVal"
	variable yTop=wDynInfoV[0]
	variable xLeft=wDynInfoV[1]
	variable yBottom=wDynInfoV[2]
	variable xRight=wDynInfoV[3]	
	variable thickness_nm=wDynInfoV[4]
	variable res=wDynInfoV[5]

	wave wDynParamV=$sDynP+"paramVal"
	variable gMax=wDynParamV[0]
	variable sMax=wDynParamV[1]
	variable iXsiMin=wDynParamV[2]
	variable max_lines=wDynParamV[3]
	variable N_min=wDynParamV[4]
	variable N_max=wDynParamV[5]
	variable patch_max=wDynParamV[6]

	nvar vModelK=$sDynP+"modelKey"	
	if(GetObjectIndex(2,vModelK)<0)
		return -1
	endif
	string sModelP=GetObjectPath(2,vModelK)
	
	variable L,phi,xc,yc
	wave wModelParV=$sModelP+"parVal"
	L=wModelParV[0]
	phi=wModelParV[1]
	xc=wModelParV[2]
	yc=wModelParV[3]

	variable iAnalyK=GetGroupDefKey(12)
	if(GetObjectIndex(12,iAnalyK)<0)
		return -1
	endif
	string sP=GetObjectPath(12,iAnalyK)

	Make/D/O/N=(2) $"RZoneVect"/WAVE=wRZoneV,$"nRZoneVect"/WAVE=wnRZoneV
	wRZoneV={xc,yc}
	wnRZoneV=-wRZoneV

	wave wModelInfoV=$sModelP+"infoVal"
	//variable dyn_corr=modelInfoV[0]
	//variable gmax=modelInfoV[1]
	//variable thresh=modelInfoV[2]
	variable dxb=wModelInfoV[4]
	variable dyb=wModelInfoV[5]
	variable alpha=wModelInfoV[6]

	Make/D/O/N=(2) $"dRbVect"/WAVE=wdRbV
	wdRbV[0]=dxb;wdRbV[1]=dyb
	
	Make/D/O/N=(2) $"rBeamVect"/WAVE=wRBeamV,$"nrBeamVect"/WAVE=wnRBeamV
	wRBeamV={xc+dxb,yc+dyb}
	wnRBeamV=-wRBeamV

	wave wUM=$sModelP+"UMat"
	wave wVM=$sModelP+"VMat"
	wave wUpM=$sModelP+"UpMat"
	wave wVpM=$sModelP+"VpMat"
	wave wuvwzV=$sModelP+"uvwzVect"
	
	wave wPhiM=$sModelP+"phiMat"
	wave wPhiIM=$sModelP+"phiIMat"
	wave wEccM=$sModelP+"eccMat"
	wave wEccIM=$sModelP+"eccIMat"
	//wave wMIM=$sModelP+"MIMat"

//
	nvar vLayerK=$sModelP+"layerKey"
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,vLayerK)

	nvar vMaterK=$sLayerP+"materKey"
	if(GetObjectIndex(13,vMaterK)<0)
		return -1
	endif
	string sMaterP=GetObjectPath(13,vMaterK)
	nvar vMaterY=$sMaterP+"materType"
	wave wOccV=$sMaterP+"occVect"

	string sRootMaterTypeP=sRootCnstnP+"materTypes:"
	wave/T wMaterTypeT=$sRootMaterTypeP+"title"
	string sMaterTypeN=wMaterTypeT[vMaterY]
	string sMaterTypeP=sRootMaterTypeP+sMaterTypeN+":"

	wave wdCoordM=$sMaterTypeP+"dCoordMat"
	wave wSpcV=$sMaterTypeP+"spcVect"

	nvar vStructY=$sLayerP+"structType"

//
	nvar vBeamK=$sModelP+"beamKey"
	if(GetObjectIndex(0,vBeamK)<0)
		return -1
	endif
	string sBeamP=GetObjectPath(0,vBeamK)

	wave wBeamParV=$sBeamP+"parVal"
	Variable E=wBeamParV[0]
			
	Variable lambda=get_wvln(E)
	Variable K0=1/lambda

//
	variable camconst=lambda*L
	Make/D/O/N=3 $"xVect"/WAVE=wXV,$"yVect"/WAVE=wYV,$"zVect"/WAVE=wZV
	wXV={1,0,0}
	wYV={0,1,0}
	wZV={0,0,1}
	
//	variable vol=MatrixDet(wUM)
	variable volp=MatrixDet(wUpM)

	Make/D/O/N=(3) $"ruvwzVect"/WAVE=wRuvwzV
	getVect(wUM,wuvwzV,wRuvwzV)

//find 2-D basis	
	Duplicate/O wVpM,$sModelP+"VpTMat"/WAVE=wVpTM
	MatrixTranspose wVpTM

	Duplicate/O wUM,$sModelP+"UTMat"/WAVE=wUTM
	MatrixTranspose wUTM

	Make/D/O/N=(3) $"uvwpzVect"/WAVE=wuvwpzV

	getVect(wVpTM,wRuvwzV,wuvwpzV)
	Factorize(wuvwpzV)
	variable H=sqrt(DotProd(wuvwpzV,wuvwpzV))

	FindhklMatrix(wuvwpzV)
	Duplicate/O M_result,$"FMat"/WAVE=wFM

	MatrixInverse wFM
	Duplicate/O M_inverse,$"FIMat"/WAVE=wFIM

// Find gx,gy
	Make/D/O/N=(3) $"gxVect"/WAVE=wGxV,$"gyVect"/WAVE=wGyV
	Make/D/O/N=(3) $"XYZVect"/WAVE=wXYZV

	wXYZV={1,0,0}	
	MatrixMultiply wFM,wXYZV
	wave wMProd=M_product
	wGxV=wMProd
				
	wXYZV={0,1,0}	
	MatrixMultiply wFM,wXYZV
	wGyV=wMProd

//
	Make/D/O/N=3 $"hklVect"/WAVE=whklV,$"gVect"/WAVE=wGV

	variable i,j,k

	//wave VM=$sModelPath+"VMat"
	//make_dynhklMat(iDynKey)

	Make/D/O/N=(3) $"hkl1Vect"/WAVE=whkl1V,$"hkl2Vect"/WAVE=whkl2V
	Make/D/O/N=(3) $"hklpVect"/WAVE=whklpV
	Make/D/O/N=(3) $"dhklVect"/WAVE=wdhklV,$"dgVect"/WAVE=wdGV

	wave wDynC=$sDynP+"dynCalc"
	wDynC=0
	Variable ix,iy
	variable xSize=abs(xRight-xLeft)+1,ySize=(yTop-yBottom)+1
	Redimension/N=(xSize,ySize) wDynC
	variable xSizeP=res*(xSize-1)+1,ySizeP=res*(ySize-1)+1
	Make/O/D/N=(xSizeP,ySizeP) $"dynCalcScaled"/WAVE=wDynCalcS
	wDynCalcS=0

	variable iCheck=0
	variable nCheck=100
	variable do_quit=0

	variable kxc=-K0*dxb/L
	variable kyc=-K0*dyb/L
	variable kzc=sqrt(K0^2-kxc^2-kyc^2)			

	Make/D/O/N=(3) $"KcVect"/WAVE=wKcV
	wKcV=kxc*wXV+kyc*wYV+kzc*wZV

	Make/D/O/N=(2) $"dRVarV"/WAVE=wdRVarV,$"KxyVect"/WAVE=wKxyV
	Make/D/O/N=(2) $"rVect"/WAVE=wRV,$"r0Vect"/WAVE=wR0V

	variable patchSize=ceil(sqrt(xsizeP*ysizeP/patch_max))

	variable nPatchX,nPatchY	
	if(ySizeP>xSizeP)
		nPatchY=ceil(ysizeP/patchSize)
		nPatchX=floor(patch_max/nPatchY)
		if(nPatchX<1)
			nPatchX=1
		endif
	else
		nPatchX=ceil(xsizeP/patchSize)
		nPatchY=floor(patch_max/nPatchX)
		if(nPatchY<1)
			nPatchY=1
		endif
	endif
	
	variable patchSizeX=trunc(xsizeP/nPatchX)
	variable patchSizeY=trunc(ysizeP/nPatchY)
	Print"--------\r"
	
	variable absorp=0.
	
	//set diagonal
	wdhklV=0			
	variable/C iXsi0=get_Uhkl_gen(E,wdhklV,wdCoordM,wSpcV,wOccV,wVM,volp)/K0
	
	variable RVar,theta
	variable px,py
	for(px=0;px<nPatchX;px+=1)
		variable xP_left=px*patchSizeX
		variable xP_right=(px+1)*patchSizeX
		
		for(py=0;py<nPatchY;py+=1)
			printf "patch: %g/%g, %g/%g\r",px+1,nPatchX,py+1,nPatchY
			variable yP_top=(py+1)*patchSizeY
			variable yP_bottom=py*patchSizeY

			if(px==nPatchX-1)
				xP_right=xsizeP
			endif
			if(py==nPatchY-1)
				yP_top=ysizeP
			endif

//
			variable xP0=(xP_right+xP_left)/2
			variable yP0=(yP_bottom+yP_top)/2
	
			//variable xVar=xLeft+xP0/res
			//variable yVar=yBottom+yP0/res
			
			wRV={xLeft+xP0/res,yBottom+yP0/res}
			TranslatePointN(wRV,wRBeamV)
			TransformPoint(wRV,wEccIM)
			TranslatePoint(wRV,wRBeamV)			

			TranslatePointN(wRV,wRZoneV)
			TransformPoint(wRV,wPhiIM)
			TranslatePoint(wRV,wRZoneV)			

			wKxyV=(wRV-wRBeamV)/camconst

			//MatrixMultiply wMIM,wKxyV
			//wave wMProd=M_Product
			//wKxyV=wMProd

			//variable kxp=cphi*kx+sphi*ky
			//variable kyp=-sphi*kx+cphi*ky
	
			variable kz=sqrt(K0^2-norm(wKxyV)^2)			
			Make/D/O/N=(3) $"KVect"/WAVE=wKV
			wKV=wKxyV[0]*wXV+wKxyV[1]*wYV-kz*wZV
			
//add 000
			variable nBeams=0
			
			whklV=0//000
			Make/D/O/N=(nBeams+1,3) $sDynP+"hklMat"/WAVE=whklM
			whklM[nBeams][]=whklV[q]

			Make/D/O/N=(nBeams+1) $sDynP+"critVect"/WAVE=wCritV
			wCritV[nBeams]=0

			nBeams+=1
			
//add any other reflections in diskMat
			wave wDiskM=$sDynP+"diskMat"
			variable nDisk=DimSize(wDiskM,0)
			
			variable add_beam
			for(i=0;i<nDisk;i+=1)
				whklV=wDiskM[i][p]
				add_beam=1
				for(j=0;j<nBeams;j+=1)
					whklpV=whklM[j][p]
					if(AreEqual(whklV,whklpV))
						add_beam=0
					endif
				endfor
				
				if(add_beam)
					Redimension/N=(nBeams+1,3) whklM
					whklM[nBeams][]=whklV[q]

					Redimension/N=(nBeams+1) wCritV
					wCritV[nBeams]=0
					nBeams+=1
				endif
			endfor
					
//add any other reflections in suppMat
			wave wSupM=$sDynP+"supMat"
			variable nSup=DimSize(wSupM,0)

			for(i=0;i<nSup;i+=1)
				whklV=wSupM[i][p]
				add_beam=1
				for(j=0;j<nBeams;j+=1)
					whklpV[]=whklM[j][p]
					if(AreEqual(whklV,whklpV))
						add_beam=0
					endif
				endfor
				
				if(add_beam)
					Redimension/N=(nBeams+1,3) whklM
					whklM[nBeams][]=whklV[q]

					Redimension/N=(nBeams+1) wCritV
					wCritV[nBeams]=0
					nBeams+=1
				endif
			endfor

			variable nFixedBeams=nBeams
					
//make disk list
			Make/D/O/N=(nDisk) $sDynP+"diskList"/WAVE=wDiskL

			for(i=0;i<nDisk;i+=1)
				whklV=wDiskM[i][p]
				for(j=0;j<nBeams;j+=1)
					whklpV=whklM[j][p]
					if(AreEqual(whklV,whklpV))
						wDiskL[i]=j
					endif
				endfor
			endfor

//
			variable N
			for(N=N_min;N<=N_max;N+=1)		
				variable Nx,Ny
				variable Gzone=(N+1)*H*sqrt(2*K0/(N+1)/H-1)
				if(Gzone>gmax)
					Gzone=gmax
				endif
				FindMaxIndices(Gzone,wGxV,wGyV,Nx,Ny)
	
				variable mX,mY
				for(mY=-NY;mY<=NY;mY+=1)
					for(mX=-NX;mX<=NX;mX+=1)
						wXYZV={mx,my,N}				
						MatrixMultiply wFM,wXYZV
						wave wMProd=M_product
						whklpV=wMProd

						getVect(wVpM,whklpV,wGV)
						variable g=norm(wGV)
						if(g<=gmax)
							getVect(wUTM,wGV,whklV)
							RoundIndices(whklV,1.e-8)
							add_beam=1
							for(i=0;i<nFixedBeams;i+=1)
								whklpV=whklM[i][p]
								if(AreEqual(whklV,whklpV))
									add_beam=0
									break
								endif
							endfor
							if(!add_beam)
								continue
							endif

							variable shkl=get_shkl(wKV,wGV)		
							if(abs(shkl)<sMax)										
								variable iPos=nBeams
								variable/C iXsi=get_Uhkl_gen(E,whklV,wdCoordM,wSpcV,wOccV,wVM,volp)/K0
								variable magiXsi=magsqr(iXsi)^0.5
								variable crit=magiXsi/(abs(shkl)+1e-12)
								if(crit>=iXsiMin)						
									for(i=nFixedBeams;i<nBeams;i+=1)
										if(crit>wCritV[i])
											iPos=i
											break
										endif
									endfor
						
									if(nBeams<max_lines)
										Redimension/N=(nBeams+1,3) whklM
										Redimension/N=(nBeams+1) wCritV
										nBeams+=1
									endif

									for(i=nBeams-1;i>=iPos;i-=1)
										whklM[i+1][]=whklM[i][q]
										wCritV[i+1]=wCritV[i]
									endfor
							
									if(iPos<nBeams)					
										//RoundIndices(whklpV,1e-7)//doesn't fix trunc problem
										whklM[iPos][]=whklV[q]//
										wCritV[iPos]=crit
									endif
								endif
							endif
						endif
					endfor
				endfor
			endfor

//
			//Print "nBeams:",nBeams,"\r"
			Make/C/O/N=(nBeams,nBeams) $"AMat"/WAVE=wAM,$"ApMat"/WAVE=wApM
			wAM=0
			wApM=0
	
			for(i=0;i<nBeams;i+=1)
				whkl1V=whklM[i][p]
				getVect(wVM,whkl1V,wGV)
				for(j=i+1;j<nBeams;j+=1)
					whkl2V=whklM[j][p]
					getVect(wVM,whkl2V,wGV)
					wdhklV=whkl2V-whkl1V
							
					iXsi=get_Uhkl_gen(E,wdhklV,wdCoordM,wSpcV,wOccV,wVM,volp)/K0
					wAM[i][j]=iXsi/2
					wAM[j][i]=conj(wAM[i][j])

					wApM[i][j]=absorp*wAM[i][j]
					wApM[j][i]=conj(wApM[i][j])
				endfor
			endfor
				
			//set diagonal
			wApM+=absorp*iXsi0*Kdelta(p,q)			
			
			//Printf "(bottom: %g,top: %g)\r",yP_bottom,yP_top
			for(ix=xP_left;ix<xP_right;ix+=1)
				for(iy=yP_bottom;iy<yP_top;iy+=1)

					//variable ixp=ix,iyp=yp_Bottom+(yP_top-iy)
					wR0V={xLeft+ix/res,yBottom+iy/res}
					wRV=wR0V
					TranslatePointN(wRV,wRBeamV)
					TransformPoint(wRV,wEccIM)
					
					TranslatePoint(wRV,wRBeamV)
					TranslatePointN(wRV,wRZoneV)
					TransformPoint(wRV,wPhiIM)
										
					wKxyV[]=wRV/camconst
					//wKxyV[0]=-wGDiskV[0];wKxyV[1]=-wGDiskV[1]
				
					kz=sqrt(K0^2-norm(wKxyV)^2)			
					wKV=wKxyV[0]*wXV+wKxyV[1]*wYV-kz*wZV
					for(i=0;i<nBeams;i+=1)
						whklV=whklM[i][p]
						getVect(wVM,whklV,wGV)
						variable s=get_shkl(wKV,wGV)
						wAM[i][i]=s//get_shkl(wKV,wGV)
					endfor
							
					MatrixEigenV/R wAM
					wave/C wEigenV=W_eigenValues
					wave/C wEigenM=M_R_eigenVectors
					//DoUpdate

					Make/C/O/N=(nBeams) $"eigenpVect"/WAVE=wEigenpV
					Make/C/O/N=(nBeams) $"epsVect"/WAVE=wEpsV
					wEpsV[]=conj(wEigenM[0][p])
					
					//absorption
					Duplicate/C/O wEigenM,M_R_eigenVectorsAdj
					wave/C wEigenAdjM=M_R_eigenVectorsAdj
					MatrixTranspose wEigenAdjM
					wEigenAdjM=conj(wEigenAdjM)
					MatrixMultiply wApM,wEigenM
					wave/C wMProdC=M_product
					MatrixMultiply wEigenAdjM,wMProdC
					wEigenpV=wMProdC[p][p]
	
					//find I
					variable/C im=cmplx(0,1)
					Make/C/O/N=(nBeams) $"CgVect"/WAVE=wCgV
					for(j=0;j<nDisk;j+=1)

						whklV[]=whklM[wDiskL[j]][p]
						getVect(wVM,whklV,wGV)

						wRV=wR0V
						wRV[0]-=L*wGV[0]/kz
						wRV[1]-=L*wGV[1]/kz
						TranslatePointN(wRV,wRBeamV)
						TransformPoint(wRV,wEccM)
					
						RVar=norm(wRV)
						theta=abs(atan(RVar/L))
						if(theta>alpha/1000)
							continue
						endif
					
						wCgV[]=wEigenM[wDiskL[j]][p]

						variable/C psig=cmplx(0,0)
						for(i=0;i<nBeams;i+=1)
							variable/C phase=2*pi*im*(wEigenV[i]+im*wEigenpV[i])*thickness_nm
							psig+=wEpsV[i]*wCgV[i]*exp(phase)//cmplx(cos(phase),sin(phase))
						endfor

						//whklV[]=whklM[wDiskL[j]][p]
						//getVect(wVM,whklV,wGV)

						//Scale to direct space
						//wRV=wRZoneV+L*wGV/kz
	
						//rotation about origin
						//TransformVect(wRV,wRM)

						//variable ixp=ix+res*wRV[0],iyp=iy+res*wRV[1]
					
						if((0<=ix)&&(ix<xSizeP)&&(0<=iy)&&(iy<ySizeP))
							wDynCalcS[ix][iy]+=magsqr(psig)//incoherent
						endif
					endfor
			
					iCheck+=1
					if(iCheck>nCheck)
						if(GetKeyState(0)&32)	
							do_quit=1
						endif
					iCheck=0
					endif

					if(do_quit)
						break
					endif
				endfor
		
				if(do_quit)
					break
				endif
			endfor
		endfor


	endfor
	wDynC=wDynCalcS[p*res][q*res]
	
	//Get log of image	
	ImageStats/M=1 wDynC
	variable Imax=V_max
	variable Imin=V_min
	Duplicate/O wDynC,$sDynP+"dynCalcLog"/WAVE=wDynCalcL	
	wDynCalcL=log(wDynC)

	Duplicate/O wDynC $"dynNumType"/WAVE=wDynNumT
	wDynNumT=numtype(wDynCalcL)
	
	if(Imin==0)
		if(Imax>Imin)
			Duplicate/O wDynC,$"dynAdjust"/WAVE=wDynA	
			wDynA=(wDynNumT!=0)?1e8:wDynCalcL
			ImageStats/M=1 wDynA
			Imin=V_min
