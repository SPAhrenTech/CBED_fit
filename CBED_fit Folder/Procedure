		//TranslateDel(wDelRV,wdRcV)

		//inverse rotation about origin
		//TransformDel(wDelRV,wRIM)

		if(FindLineInCircle(wDelRV,wRBeamV[0],wRBeamV[1],rad,wX,wY))
		//transform endpoint 0
			wRV={wX[0],wY[0]}
			TranslatePointN(wRV,wRBeamV)
			TransformPoint(wRV,wEccM)
			TranslatePoint(wRV,wRBeamV)			
			wX[0]=wRV[0];wY[0]=wRV[1]
			
