Function RefreshModelPlot(iPlotK)
variable iPlotK

	if(GetObjectIndex(11,iPlotK)<0)
		return -1
	endif
	string sPlotP=GetObjectPath(11,iPlotK)
	string sPlotN=GetObjectName(11,iPlotK)
	nvar vS=$sPlotP+"status"


	nvar vGraphK=$sPlotP+"graphKey"
	if(GetObjectIndex(8,vGraphK)<0)
		return -1
	endif
	string sGraphP=GetObjectPath(8,vGraphK)
	string sGraphN=GetObjectName(8,vGraphK)

	//
	if(vS>1)
		//RemovePlot(iGraphKey,iPlotKey,0)
		string sTraceL=TraceNameList(sGraphN,";",1)
		Variable i=0
		do
			string sN=StringFromList(i,sTraceL)
			if(strlen(sN)==0)
				break
			endif
			if(strsearch(sN,sPlotN,0)>=0)
				RemoveFromGraph/W=$sGraphN/Z $sN
			endif
			i=i+1
		while(1)	

	endif

//
	wave wValL=$sPlotP+"valList"
	variable iWidth=wValL[0]
	variable iStyle=wValL[1]
	variable iMarker=wValL[2]
	variable iRed=wValL[3]
	variable iGreen=wValL[4]
	variable iBlue=wValL[5]
	variable iShow=wValL[6]
	variable iSize=wValL[7]
	variable iReverse=wValL[8]
	variable iBrightness=wValL[9]
	variable iContrast=wValL[10]
	variable iSubtype=wValL[11]

	nvar vSubY=$sPlotP+"subType"

//
	nvar vModelK=$sPlotP+"sourceKey"
	if(GetObjectIndex(2,vModelK)<0)
		return -1
	endif
	string sModelN=GetObjectName(2,vModelK)
	string sModelP=GetObjectPath(2,vModelK)

	wave wModelParV=$sModelP+"parVal"	
	variable L=wModelParV[0]
	variable phi=wModelParV[1]
	variable xc=wModelParV[2]
	variable yc=wModelParV[3]
	variable recc=wModelParV[4]
	variable rho=wModelParV[5]

	wave wModelInfoV=$sModelP+"infoVal"	
	variable dXb=wModelInfoV[4]
	variable dYb=wModelInfoV[5]
	variable alpha=wModelInfoV[6]

	variable rad=L*tan(alpha/1000)

	wave wPhiM=$sModelP+"PhiMat"	
	wave wPhiIM=$sModelP+"PhiIMat"	
	wave wEccM=$sModelP+"EccMat"	
	wave wEccIM=$sModelP+"EccIMat"	
	wave wEccITM=$sModelP+"EccITMat"	

	Make/O/D/N=(2) $"dRBeamVect"/wave=wdRBeamV
	//variable xc=L*sin(phiX/1000)
	//variable yc=L*sin(phiY/1000)
	wdRBeamV={dXb,dYb}

	string sZoneXN=sPlotN+"_zoneX"
	string sZoneYN=sPlotN+"_zoneY"
	
	if(vS>1)
		Make/D/O/N=(1) $sPlotP+sZoneXN,$sPlotP+sZoneYN
	endif
	wave wZoneX=$sPlotP+sZoneXN
	wave wZoneY=$sPlotP+sZoneYN	

	Make/D/O/N=(2) $"rVect"/wave=wRV
	Make/O/D/N=(2) $"rZoneVect"/wave=wRZoneV

	//start with zone center at origin
	wRZoneV={0,0}
	TranslatePointN(wRZoneV,wdRBeamV)
	TransformPoint(wRZoneV,wEccM)
	TranslatePoint(wRZoneV,wdRBeamV)
	TranslatePoint(wRZoneV,{xc,yc})
		
	wZoneX[0]=wRZoneV[0];wZoneY[0]=wRZoneV[1]

	Make/D/O/N=(2) $"rBeamVect"/wave=wRBeamV
	wRBeamV={xc+dxb,yc+dyb}	

	
	if(iShow)
		switch(vSubY)
			case 0://zone center
			if(vS>1)
				AppendToGraph/W=$sGraphN wZoneY vs wZoneX
			endif
			ModifyGraph/W=$sGraphN mode($sZoneYN)=3,marker($sZoneYN)=iMarker,msize($sZoneYN)=iSize
			ModifyGraph/W=$sGraphN mrkThick($sZoneYN)=1,rgb($sZoneYN)=(iRed,iGreen,iBlue)
			break
		
			case 1:	//beam ellipse
			string sBeamXN=sPlotN+"_beamX"
			string sBeamYN=sPlotN+"_beamY"
			if(vS>1)
				Make/D/O/N=(361) $sPlotP+sBeamXN,$sPlotP+sBeamYN
			endif
			wave wBeamXV=$sPlotP+sBeamXN
			wave wBeamYV=$sPlotP+sBeamYN
	
			for(i=0;i<=360;i+=1)
				wRV[0]=rad*cos(i*pi/180);wRV[1]=-rad*sin(i*pi/180)
				TransformPoint(wRV,wEccM)
				TranslatePoint(wRV,wRBeamV)
				wBeamXV[i]=wRV[0];wBeamYV[i]=wRV[1]
			endfor

			if(vS>1)
				AppendToGraph/W=$sGraphN wBeamYV vs wBeamXV		
			endif				
			break
		endswitch
	endif
	
End	
	
