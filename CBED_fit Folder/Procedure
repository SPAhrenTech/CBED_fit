Function FindDelRV(iModelK,whklV,is_excess,wDelRV)
variable iModelK
Wave whklV
variable is_excess
wave wDelRV

	if(GetObjectIndex(2,iModelK)<0)
		return -1
	endif
	string sModelP=GetObjectPath(2,iModelK)
	
	wave wModelInfoV=$sModelP+"infoVal"
	variable dyn_corr=wModelInfoV[0]
	variable dXBeam=wModelInfoV[4]
	variable dYBeam=wModelInfoV[5]
	variable alpha=wModelInfoV[6]

	nvar vLayerK=$sModelP+"layerKey"
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,vLayerK)

	nvar vBeamK=$sModelP+"beamKey"
	if(GetObjectIndex(0,vBeamK)<0)
		return -1
	endif			
	string sBeamP=GetObjectPath(0,vBeamK)	

	wave wBeamParV=$sBeamP+"parVal"
	variable E=wBeamParV[0]

	wave wUM=$sModelP+"UMat"
	wave wVM=$sModelP+"VMat"
	
	Make/D/O/N=(3) $"gVect"/WAVE=wGV
	getVect(wVM,whklV,wGV)

	wave wuvwzV=$sModelP+"uvwzVect"

//-----------------
	wave wModelCalcV=$sModelP+"calcVal"
	Variable dE1=wModelCalcV[0]

	wave wModelParV=$sModelP+"parVal"	
	Variable L,phi,XZone,YZone,recc,rho
	L=wModelParV[0]
	phi=wModelParV[1]
	XZone=wModelParV[2]
	YZone=wModelParV[3]
	recc=wModelParV[4]
	rho=wModelParV[5]
	
	Make/D/O/N=(2) $"rZoneVect"/WAVE=wRZoneV
	wRZoneV[0]=XZone;wRZoneV[1]=YZone

	Make/D/O/N=(2) $"rBeamVect"/WAVE=wRBeamV
	wRBeamV[0]=XZone+dXBeam;wRBeamV[1]=YZone+dYBeam

	Make/D/O/N=(3) $"ruvwzVect"/WAVE=wRuvwzV
	getVect(wUM,wuvwzV,wRuvwzV)
	Variable n=DotProd(wRuvwzV,wGV)
	Variable dE=0
	if(dyn_corr&&(abs(n)>0.5))
		dE=dE1/n
	endif
	Variable Ekin=E-dE
	variable lambda_kin=get_wvln(Ekin)
	
	wave wPhiM=$sModelP+"phiMat"
	wave wEccM=$sModelP+"EccMat"
	GetDelRV(wGV,lambda_kin,L,wRZoneV,wRBeamV,wPhiM,wEccM,is_excess,wDelRV)
End

