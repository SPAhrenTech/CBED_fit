Function MatrixDiagonalPseudoInverseLeft(wM)
wave wM

	string sP="root:Heap:"

	Duplicate /O wM,$sP+"MT"
	wave wMT=$sP+"MT"
	MatrixTranspose wMT
	MatrixMultiply wMT,wM
	Duplicate /O M_product,$sP+"M_result",$sP+"M_diag"
	wave wMRes=$sP+"M_result"
	wave wMDiag=$sP+"M_diag"
	MatrixDiagonal(wMDiag)
	wMRes=wMDiag

	Variable det=MatrixDet(wMRes)
	Variable mtrace=MatrixTrace(wMRes)
	if(mtrace==0)
		return 0
	endif
	Variable tol=1e-24
	Variable nSize=DimSize(wMRes,0)
	Variable tdet=abs(det)^(1/nSize)
	if(abs(tdet/mtrace)<tol)
		return 0//not invertible
	endif

	MatrixInverse wMRes	
	MatrixMultiply M_inverse,wMT		
	Duplicate /O M_product,$sP+"M_result"
	KillWaves wMT
	
	return 1//inverted
end

