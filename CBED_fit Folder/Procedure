Function NewHough(wAdjImage,yTop,xLeft,yBottom,xRight)
wave wAdjImage
variable yTop,xLeft,yBottom,xRight

	variable iHoughK=CreateObject(10)
	if(GetObjectIndex(10,iHoughK)<0)
		return -1
	endif
	string sHoughP=GetObjectPath(10,iHoughK)
	string sHoughN=GetObjectName(10,iHoughK)
		
 	//	
	Make/D/O/N=(15) $sHoughP+"infoVal"
	
	nvar vTableK=$sHoughP+"tableKey"
	vTableK=-1//table

	wave wPrefV=$sHoughP+"prefVal"
	variable defRed=wPrefV[4]
	variable defGreen=wPrefV[5]
	variable defBlue=wPrefV[6]
	variable defMarker=wPrefV[7]
	variable defSize=wPrefV[8]
	variable iCoords=wPrefV[9]

	variable sizeX=abs(xRight-xLeft)+1
	variable sizeY=abs(yTop-yBottom)+1

	variable rRange=sqrt(sizeX^2+sizeY^2)/2
	variable rSteps=trunc(rRange)
	variable tSteps=rSteps
	
	wave wInfoV=$sHoughP+"infoVal"
	wInfoV[0]=yTop
	wInfoV[1]=xLeft
	wInfoV[2]=yBottom
	wInfoV[3]=xRight
	wInfoV[4]=rRange
	wInfoV[5]=rSteps
	wInfoV[6]=tSteps
	wInfoV[7]=0//default line #
	wInfoV[8]=1//default dx
	wInfoV[9]=1//default dy
	wInfoV[10]=defRed//default
	wInfoV[11]=defGreen//default
	wInfoV[12]=defBlue//default
	wInfoV[13]=defMarker//default
	wInfoV[14]=defSize//default
	wInfoV[15]=0//iCoords
	
	Make/D/O/N=(0,2) $sHoughP+"rDelMat"
	Make/D/O/N=(tSteps,rSteps) $sHoughP+"houghCalc"
	wave wHoughC=$sHoughP+"houghCalc"

	SetScale/I y rRange,0,"", wHoughC
	SetScale/I x 0,360,"", wHoughC
	
	wHoughC=0
	variable iTheta,iRad,iS
	Make/D/O/N=(rSteps,rSteps) $sHoughP+"sTemp"
	wave wSTemp=$sHoughP+"sTemp"
	//NewImage wSTemp
	variable x0=sizeX/2,y0=sizeY/2
	for(iTheta=0;iTheta<tSteps;iTheta+=1)
		variable theta=2*pi*iTheta/tSteps
		variable sTheta=sin(theta),cTheta=cos(theta)
		variable q0=rSteps/2,p0=rSteps/2
		variable qScale=rRange/rSteps,pScale=rRange/rSteps
		wSTemp[][]=wAdjImage(-sTheta*qScale*(q-q0)+q0+cTheta*pScale*(p-p0)+p0)(cTheta*qScale*(q-q0)+q0+sTheta*pScale*(p-p0)+p0)
		for(iS=0;iS<rSteps;iS+=1)
			wHoughC[iTheta][]+=wSTemp[q][iS]
		endfor
	endfor
	KillWaves wSTemp
	
	//	
	Make/O/D/N=2 $sHoughP+"xBounds",$sHoughP+"yBounds"
	wave wXBounds=$sHoughP+"xBounds"
	wave wYBounds=$sHoughP+"yBounds"	
	wXBounds[0]=0;wYBounds[0]=0
	wXBounds[1]=tSteps;wYBounds[1]=rSteps
	
	Variable sizeMax=512
	Variable sizePX=sizeX,sizePY=sizeY
	if(sizePX>sizePY)
		if(sizePX>sizeMax)
			sizePX=sizeMax
			sizePY=sizeMax*sizeY/sizeX
		endif
	else
		if(sizePY>sizeMax)
			sizePY=sizeMax
			sizePX=sizeMax*sizeX/sizeY
		endif
	endif

  	Display/B/L/K=1/N=$sHoughN as "Hough"
  	AppendToGraph/W=$sHoughN wYBounds vs wXBounds	
	ModifyGraph/W=$sHoughN mode(yBounds)=3,mrkThick(yBounds)=0
	SetAxis/W=$sHoughN left 0,rRange
	SetAxis/W=$sHoughN bottom 0,360
	ModifyGraph/W=$sHoughN standoff(left)=0
	ModifyGraph/W=$sHoughN standoff=0
	ModifyGraph/W=$sHoughN width=0,height=0
	ModifyGraph/W=$sHoughN mirror=1
	ModifyGraph/W=$sHoughN gfSize=10
	ModifyGraph/W=$sHoughN margin(left)=12+24*iCoords,margin(bottom)=12+24*iCoords,margin(right)=12,margin(top)=12
	
	if(iCoords)
		ModifyGraph/W=$sHoughN noLabel=0
	else
		ModifyGraph/W=$sHoughN noLabel=2
	endif	
	SetWindow $sHoughN,hook(myhook)=HoughWindowHook,userdata=GetKeyString(iHoughK)

	AppendImage/W=$sHoughN wHoughC
	ShowInfo/W=$sHoughN
	SetGroupDefkey(10,iHoughK)
	DrawHoughPanel(0,1)
End

