Function GraphPanelHook(s)
struct WMWinHookStruct &s

	Variable hookResult = 0
	string sWin=s.winname
	string sGroupK=GetUserData(sWin,"","")
	variable iGroupK=str2num(sGroupK)
	string sRootP="root:"	
	string sRootObjectP=GetRootObjectPath(iGroupK)
	variable iObjectK,iObject=GetGroupDef(iGroupK,iObjectK)
	if(iObject<0)
		return hookResult
	endif
	string sObjectN=GetObjectName(iGroupK,iObjectK)
	string sObjectP=GetObjectPath(iGroupK,iObjectK)

	string sDefaultP=sRootObjectP+"default:"
	nvar vGraphTab=$sRootObjectP+"tab"

	switch(s.eventCode)
		case 0:				//activate
		break

		case 2:				// Kill
		break

		case 3:				// MouseDown
		if(s.eventMod & 4)//option
			variable isPlotTab=(vGraphTab==0)&&(s.mouseLoc.v>62)&&(s.mouseLoc.v<286)

			String popupItems
			if(isPlotTab)//graph
				popupItems ="Set plot defaults;Get plot defaults;"
			else//plot
				popupItems ="Set defaults;Get defaults;"
			endif
			PopupContextualMenu popupItems
			if(!isPlotTab)//graph
				strswitch(S_selection)
					case "Set defaults":
					SetDefaultObject(iGroupK,iObjectK)
					break

					case "Get defaults":
					GetDefaultObject(iGroupK,iObjectK)
					break
				endswitch
			else//plot
				nvar vDefPlotK=$sObjectP+"defPlotKey"
				wave wPlotK=$sObjectP+"key"
				variable iPlot=Findindex(vDefPlotK,wPlotK)
				if(iPlot<0)
					return hookResult
				endif
				strswitch (S_selection)
					case "Set plot defaults":
					SetDefaultObject(11,vDefPlotK)
					break

					case "Get plot defaults":
					GetDefaultObject(11,vDefPlotK)
					break
				endswitch
				Evaluate()
			endif
			
		endif
		hookResult =1
		break
			
		case 7:				// Cursor moved
		hookResult = 0
		break
	
		case 12://moved
		GetWindow $sWin wsizeRM
		variable xLeft=V_left,yTop=V_top
		SetGroupPanelLocation(iGroupK,xLeft,yTop)
		break

		case 17:				// KillVote
		break
		
		default:
		break
		

	endswitch

	return hookResult		// 0 if nothing done, else 1
End

