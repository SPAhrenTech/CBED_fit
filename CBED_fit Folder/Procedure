//
Function GetKeyInteger(sKey)
string sKey
	Variable iKey=0
	Variable i
	Variable ndig=strlen(sKey)
	for(i=0;i<ndig;i+=1)
		Variable fac=10^(ndig-1-i)
		string sChar=sKey[i]
		Variable iChar=GetAlphaCharNum(sChar)
		iKey+=iChar*fac
	endfor
	return iKey
End

//
Function/T GetKeyString(iKey)
Variable iKey
	string sKey=""
	Variable i
	Variable ndig=6
	for(i=0;i<ndig;i+=1)
		Variable fac=10^(ndig-1-i)
		Variable iChar=trunc(iKey/fac)
		sKey+=GetAlphaNumChar(iChar)
		iKey-=iChar*fac
	endfor
	return sKey
End

