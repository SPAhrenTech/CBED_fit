		return -1
	endif
	string sP=GetObjectPath(12,iAnalyK)
	
	nvar vModelK=$sDynP+"modelKey"
	if(GetObjectIndex(2,vModelK)<0)
		return -1
	endif	
	string sModelP=GetObjectPath(2,vModelK)

	wave dynInfoV=$sDynP+"infoVal"
	Variable gMax=dynInfoV[0]
	Variable thresh=dynInfoV[1]
	Variable iXsiMin=dynInfoV[2]
	Variable max_beams=dynInfoV[3]
	Variable thickness_nm=dynInfoV[4]
	Variable yTop=dynInfoV[5]
	Variable xLeft=dynInfoV[6]
	Variable yBottom=dynInfoV[7]
	Variable xRight=dynInfoV[8]
	Variable N_min=dynInfoV[9]
	Variable N_max=dynInfoV[10]

	wave modelP=$sModelP+"par"	
	Variable L,phi,xc,yc,recc,rho
	L=modelP[0]
	phi=modelP[1]
	xc=modelP[2]
	yc=modelP[3]
	recc=modelP[4]
	rho=modelP[5]

	wave modelInfoV=$sModelP+"infoVal"	
	variable xb=modelInfoV[4]
	variable yb=modelInfoV[5]
	variable alpha=modelInfoV[6]

	nvar vLayerK=$sModelP+"layerKey"
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,vLayerK)

	nvar vMaterK=$sLayerP+"materKey"
	if(GetObjectIndex(13,vMaterK)<0)
		return -1
	endif
	string sMaterP=GetObjectPath(13,vMaterK)
	wave dCoordM=$sMaterP+"dCoordMat"
	wave spcV=$sMaterP+"spcVect"
	wave occV=$sMaterP+"occVect"

	nvar vBeamK=$sModelP+"beamKey"
	if(GetObjectIndex(0,vBeamK)<0)
		return -1
	endif
	string sBeamP=GetObjectPath(0,vBeamK)

	wave beamP=$sBeamP+"par"
	variable E=beamP[0]
	variable lambda=get_wvln(E)
	variable K0=1/lambda
	variable camconst=L*lambda

	wave UM=$sModelP+"UMat"
	wave VM=$sModelP+"VMat"
	wave UTM=$sModelP+"UTMat"
	wave UpM=$sModelP+"UpMat"
	wave VpM=$sModelP+"VpMat"
	wave VpTM=$sModelP+"VpTMat"

	wave uvwzV=$sModelP+"uvwzVect"

	Make/D/O/N=(3) $sP+"gVect",$sP+"hklVect",$sP+"ruvwzVect"
	Wave gV=$sP+"gVect"
	Wave hklV=$sP+"hklVect"
	Wave ruvwzV=$sP+"ruvwzVect"
	
	getVect(UM,uvwzV,ruvwzV)
	Variable gz1=1/norm(ruvwzV)
	//Variable gHOLZmax=(2*K0*(Nzmax+0.5)*gz1)^0.5
	//Variable sgMin=gz1

	variable volp=MatrixDet(UpM)
	variable acp_avg=volp^(1./3.)
	variable hklpmax=trunc(acp_avg*gmax)+1
	
	Make/D/O/N=(3) $sP+"KVect"
	wave kV=$sP+"KVect"
	wave xV=$sP+"xVect"
	wave yV=$sP+"yVect"
	wave zV=$sP+"zVect"
	kV=-K0*zV

	Make/D/O/N=(3) $sP+"KbVect"
	wave kbV=$sP+"KbVect"
	variable kxb=xb*K0/L
	variable kyb=yb*K0/L
	variable kzb=-sqrt(K0^2-(kxb^2+kyb^2))
	kbV=kxb*xV+kyb*yV+kzb*zV

	Variable nBeams=0
	Make/D/O/N=(nBeams+1,3) $sDynP+"hklMat"
	wave hklM=$sDynP+"hklMat"
	hklM=0
	nBeams+=1

//find 2-D basis	
	Make/D/O/N=(3) $sP+"uvwpzVect"
	wave uvwpzV=$sP+"uvwpzVect"

	getVect(VpTM,ruvwzV,uvwpzV)
	variable H=sqrt(DotProd(uvwpzV,uvwpzV))

	FindhklMatrix(uvwpzV)
	Duplicate/O M_result,$sP+"FMat"
	wave FM=$sP+"FMat"

	MatrixInverse FM
	Duplicate/O M_inverse,$sP+"FIMat"
	wave FIM=$sP+"FIMat"
//
	Make/D/O/N=(1) $sDynP+"critVect"
	wave critV=$sDynP+"critVect"
	Redimension/N=(1) critV
	critV=0

	wave delrM=$sDynP+"delrMat"
	Redimension/N=(0,3) delrM

	Make/D/O/N=(3) $sP+"delkVect"
	wave delkV=$sP+"delkVect"

	Make/D/O/N=(3) $sP+"hpVect"
	wave hklpV=$sP+"hpVect"
	variable N,i

	Make/D/O/N=(3) $sP+"gxVect",$sP+"gyVect"
	wave gxV=$sP+"gxVect"
	wave gyV=$sP+"gyVect"

	Make/D/O/N=(3) $sP+"XYZVect"
	wave XYZV=$sP+"XYZVect"

	XYZV={1,0,0}	
	MatrixMultiply FM,XYZV
	wave mProd=M_product
	gxV=mProd
				
	XYZV={0,1,0}	
	MatrixMultiply FM,XYZV
	gyV=mProd

	for(N=N_min;N<=N_max;N+=1)
		
		variable Nx,Ny
		variable Gzone=(N+1)*H*sqrt(2*K0/(N+1)/H-1)
		FindMaxIndices(Gzone,gxV,gyV,Nx,Ny)
	
		variable mX,mY
		for(mY=-NY;mY<=NY;mY+=1)
			for(mX=-NX;mX<=NX;mX+=1)
				Make/D/O/N=(3) $sP+"XYZVect"
				wave XYZV=$sP+"XYZVect"

				XYZV={mx,my,N}				
				MatrixMultiply FM,XYZV
				wave mProd=M_product
				hklpV=mProd

				getVect(VpM,hklpV,gV)
				variable g=norm(gV)
				if((g>0)&&(g<=gmax))
					getVect(UTM,gV,hklV)

					variable shkl=get_shkl(kcV,gV)					
					variable iPos=nBeams
					variable/D magUhkl=magsqr(get_Uhkl_gen(E,hklV,dCoordM,spcV,occV,VM,volp))
					variable/C iXsi=get_Uhkl_gen(E,hklV,dCoordM,spcV,occV,VM,volp)/K0
					variable magiXsi=magsqr(iXsi)^0.5
					variable crit=magiXsi/abs(shkl)
					//Print "[",hklV[0]," ",hklV[1]," ",hklV[2],"] 1/|iXsi|:",magiXsi,", s:",shkl,", crit:",crit,"\r"
					//variable crit2=abs(sg)
					if(crit>=thresh)						
						for(i=1;i<nBeams;i+=1)
							if(crit>critV[i])
								iPos=i
								break
							endif
						endfor
						
						if(nBeams<max_beams)
							Redimension/N=(nBeams+1,3) hklM
							Redimension/N=(nBeams+1) critV
							nBeams+=1
						endif

						for(i=nBeams-1;i>=iPos;i-=1)
							hklM[i+1][]=hklM[i][q]
							critV[i+1]=critV[i]
						endfor
							
						if(iPos<nBeams)					
							hklM[iPos][]=hklV[q]//
							critV[iPos]=crit
						endif
					endif
				endif
			endfor
		endfor
	endfor
End

