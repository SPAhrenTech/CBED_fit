Function GetDFV(iPar,wParV,dPar,wdFV)
Variable iPar
wave wParV
Variable dPar
wave wdFV

	Duplicate/O wParV,$"pParVect"/WAVE=wpParV
	Duplicate/O wParV,$"mParVect"/WAVE=wmParV
	
	Duplicate/O wdFV,$"fppVect"/WAVE=wFppV
	Duplicate/O wdFV,$"fpmVect"/WAVE=wFpmV
	Duplicate/O wdFV,$"fpVect"/WAVE=wFpV
	Duplicate/O wdFV,$"fmVect"/WAVE=wFmV

	Duplicate/O wdFV,$"sigpVect"/WAVE=wSigpV
	Duplicate/O wdFV,$"sigmVect"/WAVE=wSigmV

	wpParV[iPar]=wParV[iPar]+dPar/2
	GetfV(wpParV,wFpV,wFppV,wSigpV)

	wmParV[iPar]=wParV[iPar]-dPar/2
	GetfV(wmParV,wFmV,wFpmV,wSigmV)

	wdFV[]=((wFppV[p]-wFpV[p])/wSigpV[p]-(wFpmV[p]-wFmV[p])/wSigmV[p])/dPar
End

