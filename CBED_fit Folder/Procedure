Function TransferObject(iGroupK,sObjectT,sTempF,makeDefault)
variable iGroupK
string sObjectT
string sTempF
variable makeDefault

	string sRootObjectP=GetRootObjectPath(iGroupK)

	variable iObjectK=RegisterObject(iGroupK,sObjectT,makeDefault)
	string sObjectN=GetObjectPrefix(iGroupK)+GetKeyString(iObjectK)
	string sObjectF=sRootObjectP+GetObjectName(iGroupK,iObjectK)

	string sContainingF=GetContainingFolder(sTempF)
	RenameDataFolder $sTempF,$sObjectN
	string sTempObjectF=sContainingF+":"+sObjectN
	DuplicateDataFolder $sTempObjectF,$sObjectF

	return iObjectK
End

