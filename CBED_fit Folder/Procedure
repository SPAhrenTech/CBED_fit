Function get_shkl(kV,gV)
wave kV,gV

	Variable K=norm(kV)
	Variable g=norm(gV)
	Variable g_K=DotProd(kV,gV)
	Variable gz=DotProd(kV,gV)/K
	Variable gx=sqrt(g^2-gz^2)	

	Variable shkl=-K*(1-sqrt(1-(gx/K)^2))-gz//excitation error
	
	return shkl
End

