	Make/D/O/N=(3) $sP+"bVect"/wave=wBV
	Make/D/O/N=(3) $sP+"cVect"/wave=wCV
	
	Make/D/O/N=(3,3) $sP+"AMat"/wave=wAM
	Make/D/O/N=(3,3) $sP+"ApMat"/wave=wApM
		
//
	wAV[]=wV[p]
	Variable len=Norm(wAV)
	wAV/=len 
	wAM[][0]=wAV[p]

//
	Cross wV,wVp
	wave wCrossV=W_Cross
	wCV[]=wCrossV[p]
	len=Norm(wCV)
	if(len>0.)		
		wCV/=len
	else
		Cross wV,wYV
		wCV[]=wCrossV[p]
		len=Norm(wCV)
		if(len>0.)		
			wCV/=len
		else
			Cross wZV,wV
			wCV[]=wCrossV[p]
			len=Norm(wCV)
			wCV/=len
		endif
	endif
	Cross wCV,wAV
	wBV[]=wCrossV[p]
	
	wAM[][0]=wAV[p]
	wAM[][1]=wBV[p]
	wAM[][2]=wCV[p]
	
	variable cang=cos(angdeg/180*pi)
	variable sang=sin(angdeg/180*pi)
	wApM[][0]=cang*wAV[p]+sang*wBV[p]	
	wApM[][1]=-sang*wAV[p]+cang*wBV[p]	
	wApM[][2]=wCV[p]	

//
