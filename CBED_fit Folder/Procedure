Function GetFOMV(wParV,wFOMV)
wave wParV,wFOMV

	Variable nData=DimSize(wFOMV,0)
	Make/D/O/N=(nData) $"fVect",$"fOutVect",$"sigVect"
	wave wFV=$"fVect"
	wave wFOutV=$"fOutVect"
	wave wSigV=$"sigVect"
	GetfV(wParV,wFV,wFOutV,wSigV)

	wFOMV=(wFOutV-wFV)/wSigV
	return norm(wFOMV)
End

