Function PanelWindowHook(s)
struct WMWinHookStruct &s

	string sRootP="root:"	

	Variable hookResult = 0
	string sWin=s.winname
	string sGroupK=GetUserData(sWin,"","")
	variable iGroupK=str2num(sGroupK)

	string sRootObjectP=sRootP+GetGroupName(iGroupK)+":"
	variable iObjectK,iObject=GetGroupDef(iGroupK,iObjectK)
	string sObjectN,sObjectP
	variable object_exists=0
	if(iObject<0)
	else
		object_exists=1
		sObjectN=GetObjectName(iGroupK,iObjectK)
		sObjectP=GetObjectPath(iGroupK,iObjectK)
	endif

	//
	string sDefaultP=sRootObjectP+"default:"

	switch(s.eventCode)
		case 0:				//activate
		break

		case 2:				// Kill
	//	hookResult = 1
		break

		case 3:	// MouseDown
		if(!object_exists)	
			break
		endif	
		hookResult =1
		if(s.eventMod & 4)//option
			//
			String popupItems ="Set defaults;Get defaults;"
			PopupContextualMenu popupItems
			strswitch (S_selection)
				case "Set defaults":
				SetDefaultObject(iGroupK,iObjectK)
				break

				case "Get defaults":
				GetDefaultObject(iGroupK,iObjectK)
				break
			endswitch
		endif
		break
			
		case 7:				// Cursor moved
		//hookResult = 0
		break

		case 12://moved
		GetWindow $sWin wsize//
		variable sscale=ScreenResolution/72//NewPanel sets the position in pixels, but GetWindow reads in points...
		variable xLeft=sscale*V_left,yTop= sscale*V_top
		
		SetGroupPanelLocation(iGroupK,xLeft,yTop)
		break
		
		case 17:				// KillVote
		break
		
		default:
		break
		

	endswitch

	return hookResult		// 0 if nothing done, else 1
End

