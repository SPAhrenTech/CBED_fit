Function/T TrimName(sName)
string sName
	string sNewName=""

	Variable sLen=strlen(sName)
	Variable i
	for(i=0;i<sLen;i+=1)
		Variable cpos=char2num(sName[i])
		if(cpos==char2num("."))
			break
		endif
		
		if(IsGoodChar(sName[i]))
			sNewName+=sName[i]
		endif
	endfor
	return sNewName
End

