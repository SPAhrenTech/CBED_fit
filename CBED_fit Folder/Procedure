Function RefreshModel(iModelK)
variable iModelK
	
	string sRootCnstnP="root:Constants:"
	if(GetObjectIndex(2,iModelK)<0)
		return -1
	endif
	string sModelP=GetObjectPath(2,iModelK)
	nvar vS=$sModelP+"status"
	
//
	wave wModelParV=$sModelP+"parVal"	
	Variable L,phi,xZone,yZone,eccX,eccY
	L=wModelParV[0]
	phi=wModelParV[1]
	xZone=wModelParV[2]
	yZone=wModelParV[3]
	eccX=wModelParV[4]
	eccY=wModelParV[5]

	wave wModelInfoV=$sModelP+"infoVal"
	Variable dyn_corr=wModelInfoV[0]
	Variable gmax=wModelInfoV[1]
	Variable thresh=wModelInfoV[2]
	Variable max_beams=wModelInfoV[3]

	wave wUM=$sModelP+"UMat",wVM=$sModelP+"VMat"
	wave wUpM=$sModelP+"UpMat",wVpM=$sModelP+"VpMat"

//
	nvar vLayerK=$sModelP+"layerKey"
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,vLayerK)
	nvar vStructY=$sLayerP+"structType"
	wave wLayerParV=$sLayerP+"parVal"

	wave wAM=$sLayerP+"AMat",wBM=$sLayerP+"BMat"
	wave wApM=$sLayerP+"ApMat",wBM=$sLayerP+"BpMat"

	nvar vMaterK=$sLayerP+"materKey"
	if(GetObjectIndex(13,vMaterK)<0)
		return -1
	endif
	string sMaterP=GetObjectPath(13,vMaterK)
	nvar vMaterY=$sMaterP+"materType"
	
	string sRootMaterTypeP=sRootCnstnP+"materTypes:"
	wave/T wMaterTypeT=$sRootMaterTypeP+"title"
	string sMaterTypeN=wMaterTypeT[vMaterY]
	string sMaterTypeP=sRootMaterTypeP+sMaterTypeN+":"
	wave wPrimTM=$sMaterTypeP+"primTMat"

	wave wXV=$sRootCnstnP+"xVect"
	wave wYV=$sRootCnstnP+"yVect"
	wave wZV=$sRootCnstnP+"zVect"

	//Orient zone axis
	wUM=wAM
	wave wuvwzV=$sModelP+"uvwzVect"	
	Make/D/O/N=(3) $sModelP+"zoneVect"/WAVE=wZoneV
	MatrixMultiply wUM,wuvwzV
	wave wMProd=M_product
	wZoneV=wMProd		
	RotateBasis(wUM,wZoneV,wZV)
	
	//Find reciprocal basis
	MatrixInverse wUM
	MatrixTranspose M_Inverse
	wave wMInv=M_Inverse
	wVM=wMInv

	//Orient x axis
	wave whklxV=$sModelP+"hklxVect"	
	Make/D/O/N=(3) $sModelP+"paraVect"/WAVE=wParaV
	Make/D/O/N=(3)$sModelP+"vertVect"/WAVE=wVertV
	MatrixMultiply wVM,whklxV
	wave wMProd=M_product
	wParaV=wMProd
	Cross wZV,wParaV
	wave wCross=W_Cross
	wVertV=wCross
	if(Norm(wVertV)>0)
		RotateBasis(wUM,wVertV,wYV)
	endif

	//Find reciprocal basis
	MatrixMultiply wUM,wuvwzV
	MatrixInverse wUM
	MatrixTranspose M_Inverse
	wave wMInv=M_Inverse
	wVM=wMInv
	
	//Find primitive reciprocal basis
	MatrixMultiply wUM,wPrimTM
	wave wMProd=M_product
	wUpM=wMProd
	
	MatrixInverse wUpM
	MatrixTranspose M_Inverse
	wVpM=wMInv

	//Find transposes
	Duplicate/O wUM,$sModelP+"UTMat"/WAVE=wUTM
	MatrixTranspose wUTM

	Duplicate/O wVM,$sModelP+"VTMat"/WAVE=wVTM
	MatrixTranspose wVTM

	Duplicate/O wUpM,$sModelP+"UpTMat"/WAVE=wUpTM
	MatrixTranspose wUpTM

	Duplicate/O wVpM,$sModelP+"VpTMat"/WAVE=wVpTM
	MatrixTranspose wVpTM

	//rotation
	Variable sphi=sin(phi/180*pi),cphi=cos(phi/180*pi)
	Make/D/O/N=(2,2) $sModelP+"phiMat"/WAVE=wPhiM,$sModelP+"phiIMat"/WAVE=wPhiIM
	wPhiM[0][0]=cphi;wPhiM[0][1]=-sphi
	wPhiM[1][0]=sphi;wPhiM[1][1]=cphi
	
	MatrixInverse wPhiM
	wave wMInv=M_Inverse
	wPhiIM=wMInv

	//eccentricity
	//eccX=sinh(eps)*cos(2*theta),eccX=sinh(eps)*sin(2*theta)
	variable eccR=sqrt(1+eccX^2+eccY^2)
	Make/O/N=(2,2) $sModelP+"EccMat"/WAVE=wEccM
	wEccM[0][0]=eccR+eccX;wEccM[0][1]=eccY
	wEccM[1][0]=eccY;wEccM[1][1]=eccR-eccX

	Make/O/N=(2,2) $sModelP+"EccIMat"/WAVE=wEccIM
	MatrixInverse wEccM
	wave wMInv=M_Inverse
	wEccIM=wMInv

	Make/O/N=(2,2) $sModelP+"EccITMat"/WAVE=wEccITM
	wEccITM=wEccIM
	MatrixTranspose wEccITM
	
	if(dyn_corr)
		make_hkl0Mat(iModelK)
		get_dE1(iModelK)
	endif

End

