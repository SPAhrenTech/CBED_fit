Function ExptPopupMenuProc(s):PopupMenuControl
STRUCT WMPopupAction &s

	variable ecode=s.eventCode
	if(ecode==-1)
		return -1
	endif

	struct ObjectInfo sObject
	variable iGroupK,iTab,iItem,iIndex
	FindPanelControlInfo(s.win,s.ctrlName,iGroupK,iTab,iItem,iIndex,sObject)
	
	variable iSel=s.popNum-1
	switch(iTab)
		case -1:
		switch(iItem)
			case 0:
			sObject.iK=SelectObject(iGroupK,iSel,1)	
			break

			case 1://action
			switch(iSel)
				case 0:
				sObject.iK=NewObject(iGroupK)
				break

				case 1:
				sObject.iK=ImportObject(iGroupK)
				break
		
				case 2:
				NewGraphFromObject(iGroupK,sObject.iK)
				break
		
				case 3:
				NewPlot(iGroupK,sObject.iK)
				break

				case 4:
				NewTable(iGroupK,sObject.iK)
				break

				case 5:
				RenameObjectDlg(iGroupK,sObject.iK)
				break
		
				case 6:
				sObject.iK=DeleteObject(iGroupK,sObject.iK,1)
				break

			endswitch
			break

		endswitch
		break				
	endswitch
		
	AppendRefreshUpdateRefList(iGroupK,sObject.iK,1)
End

