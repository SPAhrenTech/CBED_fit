Function ImportObjectFromFile(iGroupK)
variable iGroupK

	string sRootP="root:"
	string sGroupN=GetGroupName(iGroupK)
	string sRootObjectP=GetRootObjectPath(iGroupK)
	//variable iObject
	//variable iObject=GetGroupDefkey(iGroupKey,iObjectKey)
	string sObjectR=GetGroupRef(iGroupK)

	wave/T wObjectT=$sRootObjectP+"title"
	wave wObjectK=$sRootObjectP+"key"
	
//Select other IGOR file
	string sPathN="",sFileN=""
	String fileFilter="IGOR Files (*.pxp):.pxp;"
	variable refNum
	Open/R/Z=2/F=fileFilter/P=$sPathN refNum as sFileN
	if(V_flag==-1)
		return -1
	endif
	string sFullFileN=S_fileName

//Get list from other file
	string sPrevF=GetDataFolder(1)
	string sTempF=sRootP+"Temp"
	NewDataFolder/O $sTempF
	string sTempP=sTempF+":"
	SetDataFolder $sTempF

//check version
	nvar vVersion=$sRootP+"version"
	LoadData/J="version"/O/Q sFullFileN
	nvar vOldVersion=$sTempP+"version"
	if(!(NVAR_Exists(vOldVersion)&&(vOldVersion>=vVersion)))
		return -1
	endif
	
	string sNames="key;title"
	LoadData/J=sNames/O/Q/S=sGroupN sFullFileN//Don't include "root:", apparently
	wave wImportK=$sTempP+"key"
	wave/T wImportT=$sTempP+"title"
	SetDataFolder $sPrevF
	
//Pick
	variable iOld=PickObject(sObjectR,wImportT)
	if(iOld<0)
		return -1
	endif
	variable iOldK=wImportK[iOld]
	string sObjectT=wImportT[iOld]
	string sOldN=GetObjectPrefix(iGroupK)+GetKeyString(iOldK)
	string sOldF=sRootObjectP+sOldN
	string sGroupP=sGroupN+":"
	string sOldObjectP=sGroupP+sOldN+":"
		
//Load folder
	SetDataFolder $sTempF
	LoadData/O/S=sOldObjectP/T sFullFileN
	SetDataFolder $sPrevF
	string sImportF=sTempP+sOldN
	string sImportP=sImportF+":"
	
	variable iObjectK=TransferObject(iGroupK,sObjectT,sImportF,1)
//	SetDataFolder $"root"
	KillDataFolder/Z $sTempF//not the same as DeleteFolder
	SetDataFolder $sPrevF
	//DeleteFolder/Z sTempF

	//VerifyObject(iGroupKey,iObjectKey)
	SetGroupDefkey(iGroupK,iObjectK)
	DrawObjectPanel(iGroupK,0,1) 	

	Close/A
	//KillDataFolder/Z $sRootTempFolder
	return iObjectK
 End

