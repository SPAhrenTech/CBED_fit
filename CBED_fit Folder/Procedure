Function DoFitAddMarquee(iPlotK,yTop,xLeft,yBottom,xRight)
variable,iPlotK
variable yTop,xLeft,yBottom,xRight

	string sPrevF=GetDataFolder(1)
	SetDataFolder $"root:Heap"

	if(GetObjectIndex(11,iPlotK)<0)
		return -1
	endif
	string sPlotP=GetObjectPath(11,iPlotK)
	
//
	wave wValL=$sPlotP+"valList"
	variable iWidth=wValL[0]
	variable iStyle=wValL[1]
	variable iMarker=wValL[2]
	variable iRed=wValL[3]
	variable iGreen=wValL[4]
	variable iBlue=wValL[5]
	variable iShow=wValL[6]
	variable iSize=wValL[7]
	variable iReverse=wValL[8]
	variable iBrightness=wValL[9]
	variable iContrast=wValL[10]

	nvar vSubY=$sPlotP+"subType"
	
	if(!iShow)
		return -1
	endif
	
	//
	nvar vFitK=$sPlotP+"sourceKey"
	if(GetObjectIndex(4,vFitK)<0)
		return -1
	endif
	string sFitP=GetObjectPath(4,vFitK)
	string sFitT=GetObjectTitle(4,vFitK)
	
	//
	nvar vExptK=$sFitP+"exptKey"
	if(GetObjectIndex(1,vExptK)<0)
		return -1
	endif
	string sExptP=GetObjectPath(1,vExptK)	
	string sExptT=GetObjectTitle(1,vExptK)	

	wave wExpthklM=$sExptP+"hklMat"
	wave wExptDelRM=$sExptP+"delRMat"
	variable nExptData=DimSize(wExpthklM,0)

	Make/O/D/N=(3) $"hklVect"
	wave whklV=$"hklVect"

	Variable nFitData
	Variable iData
	variable do_add
	variable i,j,k,l

	switch(vSubY)
		case 0://del
		Make/O/D/N=(2) $"delRVect"
		wave wDelRV=$"delRVect"

		wave wFitDelL=$sFitP+"delList"	
		nFitData=DimSize(wFitDelL,0)
		l=nFitData
		for(i=0;i<nExptData;i+=1)
			wDelRV[]=wExptDelRM[iData][p]
			if(DoesIntersectRect(wDelRV,yTop,xLeft,yBottom,xRight))
				for(k=0;k<nFitData;k+=1)
					if(wFitDelL[k][0]==i)
						do_add=0
					endif		
				endfor
				if(do_add)
					Redimension/N=(l+1) wFitDelL
					wFitDelL[l]=i
					Printf "adding line in "+sExptT+": row %g\r",i
					Printf " to "+sFitT+": row %g, ",l
					l+=1
				endif
			endif
		endfor
		break

		case 1://intersections
		Make/O/D/N=(2) $"delR1Vect",$"delR2Vect"
		wave wDelR1V=$"delR1Vect"
		wave wDelR2V=$"delR2Vect"

		Make/O/D/N=(2) $"rVect"
		wave wRV=$"rVect"

		wave wFitInterL=$sFitP+"interList"		
		nFitData=DimSize(wFitInterL,0)
		l=nFitData
		for(i=0;i<nExptData;i+=1)
			wDelR1V=wExptDelRM[i][p]		
			for(j=i+1;j<nExptData;j+=1)
				wDelR2V=wExptDelRM[j][p]							
				FindInter(wDelR1V,wDelR2V,wRV)
				if(IsInsideRect(wRV,yTop,xLeft,yBottom,xRight))
					//printf "%6.0f\t%6.0f\r",i,j
					do_add=1
					for(k=0;k<nFitData;k+=1)
						if((wFitInterL[k][0]==i)&&(wFitInterL[k][1]==j))
							do_add=0
						endif		
					endfor
					if(do_add)
						Redimension/N=(l+1,2) wFitInterL
