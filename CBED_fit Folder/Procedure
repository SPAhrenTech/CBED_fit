Function GetfV(wParamV,wFV,wFOutV,wSigV)
wave wParamV,wFV,wFOutV,wSigV

	string sRootFitP=GetRootObjectPath(4)
	string sRootLayerP=GetRootObjectPath(6)
	string sRootMaterP=GetRootObjectPath(13)
	string sRootAnalyP=GetRootObjectPath(12)

	Make/D/O/N=(2) $"fitRVect"/WAVE=wFitRV
	Make/D/O/N=(2) $"exptRVect"/WAVE=wExptRV
	Make/D/O/N=(2) $"r0Vect"/WAVE=wR0V

	SetParamVals(wParamV,{3,9,11})
	
	//Set statuses
	string sAnalyP
	variable iAnalyK,iAnaly=GetGroupDef(12,iAnalyK)
	if(iAnaly<0)
		sAnalyP=sRootAnalyP+"default:"
	else	
		sAnalyP=GetObjectPath(12,iAnalyK)
	endif
	
	wave wAnalySigV=$sAnalyP+"sigVal"
	variable sig_pix=wAnalySigV[0],sig_nm=wAnalySigV[1]

	Variable i,j,k=0
	Variable FOM=0
	Variable iData
	
	//Calculated vs. experimental lines
	wave wFitK=$sRootFitP+"key"
	variable nFit=DimSize(wFitK,0),iFit
	for(iFit=0;iFit<nFit;iFit+=1)
		variable iFitK=wFitK[iFit]
		string sFitP=GetObjectPath(4,iFitK)
		
		nvar vExptK=$sFitP+"exptKey"
		string sExptP=GetObjectPath(1,vExptK)
			
		wave wFitInfoV=$sFitP+"infoVal"
		wR0V[0]=-wFitInfoV[2];wR0V[1]=-wFitInfoV[3]
		variable include_fit=wFitInfoV[4]
		variable method=wFitInfoV[5]
		
		variable nData
		if(include_fit)

			//(delx,dely) - Measure (dx,dy) between the experimental and calculated (delx,dely) coordinates describing a line.			
			switch(method)
				case 0:
				wave wFitDelRM=$sFitP+"fitDelRMat"
				wave wExptDelRM=$sFitP+"exptDelRMat"
			
				wave wDelL=$sFitP+"delList"//list of reflections to use				
				nData=DimSize(wDelL,0)
				for(iData=0;iData<nData;iData+=1)
			
					wFitRV[]=wFitDelRM[iData][p]
					wExptRV[]=wExptDelRM[iData][p]
					
					TranslateDel(wFitRV,wR0V)
					TranslateDel(wExptRV,wR0V)
					//shift_del(wRV,xc,yc)
					//shift_del(wRpV,xc,yc)

					wFV[k]=wFitRV[0];wFOutV[k]=wExptRV[0];
					wSigV[k]=sig_pix;k+=1

					wFV[k]=wFitRV[1];wFOutV[k]=wExptRV[1];
					wSigV[k]=sig_pix;k+=1
				endfor
				break

				//intersections - Measure (dx,dy) between the experimental and calculated intersections of two lines. The line pairs are
				//indicated by line number within rows of interRList. 
				case 1:
				wave wFitInterRM=$sFitP+"fitInterRMat"
				wave wExptInterRM=$sFitP+"exptInterRMat"
			
				wave wInterL=$sFitP+"interList"//list of expt reflection pairs to use
				nData=DimSize(wInterL,0)
				for(iData=0;iData<nData;iData+=1)
					wFitRV[]=wFitInterRM[iData][p]
					wExptRV[]=wExptInterRM[iData][p]
				
					wFV[k]=wFitRV[0];wFOutV[k]=wExptRV[0];
					wSigV[k]=sig_pix;k+=1

					wFV[k]=wFitRV[1];wFOutV[k]=wExptRV[1];
					wSigV[k]=sig_pix;k+=1
					//print "x: ",wRpV[0],", y: ",wRpV[1],"\r"
				endfor
