	Variable hookResult = 0
	string sWin=s.winname
	string sFolder=GetUserData(sWin,"","")
	string sRootP="root:"	
	string sRootFolderP=sRootP+sFolder+":"

	switch(s.eventCode)
		case 0:				//activate
		break


		case 2:				// Kill
	//	hookResult = 1
		break
		
		case 4://key
			switch (s.keycode)
				case 28:
					Print "Left arrow key pressed."
					hookResult = 1
					break
				case 29:
					Print "Right arrow key pressed."
					hookResult = 1
					break
				case 30:
					Print "Up arrow key pressed."
					hookResult = 1
					break
				case 31:
					Print "Down arrow key pressed."
					hookResult = 1
					break			
			endswitch
		//hookResult = 0
		break

		case 12://moved
		GetWindow $sWin wsize//
		variable sscale=ScreenResolution/72//NewPanel sets the position in pixels, but GetWindow reads in points...
		variable xLeft=sscale*V_left,yTop= sscale*V_top
		
