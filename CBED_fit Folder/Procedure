	wave wSimInfoV=$sSimP+"infoVal"
	Variable Nmin=wSimInfoV[0]
	Variable Nmax=wSimInfoV[1]
	Variable max_lines=wSimInfoV[2]
	Variable gmax=wSimInfoV[9]//not used
	variable is_excess=wSimInfoV[10]

	nvar vModelK=$sSimP+"modelKey"
	if(GetObjectIndex(2,vModelK)<0)
		return -1
	endif	
	string sModelP=GetObjectPath(2,vModelK)

	wave wModelParV=$sModelP+"parVal"	
	variable camlen=wModelParV[0]
	variable phi=wModelParV[1]
	variable xZone=wModelParV[2]
	variable yZone=wModelParV[3]
	variable recc=wModelParV[4]
	variable rho=wModelParV[5]

	wave wModelInfoV=$sModelP+"infoVal"	
	variable dxBeam=wModelInfoV[4]
	variable dyBeam=wModelInfoV[5]
	variable alpha=wModelInfoV[6]
	
	Make/D/O/N=(2) $"rZoneVect"/WAVE=wRZoneV
	wRZoneV[0]=xZone;wRZoneV[1]=yZone

	Make/D/O/N=(2) $"rBeamVect"/WAVE=wRBeamV
	wRBeamV[0]=xZone+dxBeam;wRBeamV[1]=yZone+dyBeam

	wave wPhiM=$sModelP+"phiMat"
	wave wEccM=$sModelP+"eccMat"

	nvar vLayerK=$sModelP+"layerKey"
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,vLayerK)

	nvar vMaterK=$sLayerP+"materKey"
	if(GetObjectIndex(13,vMaterK)<0)
		return -1
	endif
	string sMaterP=GetObjectPath(13,vMaterK)
	nvar vMaterY=$sMaterP+"materType"

	string sRootMaterTypeP=sRootCnstnP+"materTypes:"
	wave/T wMaterTypeT=$sRootMaterTypeP+"title"
	string sMaterTypeN=wMaterTypeT[vMaterY]
	string sMaterTypeP=sRootMaterTypeP+sMaterTypeN+":"

	wave wdCoordM=$sMaterTypeP+"dCoordMat"
	wave wSpcV=$sMaterTypeP+"spcVect"
	wave wOccV=$sMaterP+"occVect"

	nvar vStructY=$sLayerP+"structType"

	nvar vBeamK=$sModelP+"beamKey"
	if(getObjectIndex(0,vBeamK)<0)
		return -1
	endif
	string sBeamP=GetObjectPath(0,vBeamK)

	wave wBeamParV=$sBeamP+"parVal"
	Variable E=wBeamParV[0]
	Variable lambda=get_wvln(E)
	Variable K0=1/lambda
	
	variable rad=camlen*tan(alpha/1000)
	variable camconst=lambda*camlen
	wave wXV=$sRootCnstnP+"xVect"
	wave wYV=$sRootCnstnP+"yVect"
	wave wZV=$sRootCnstnP+"zVect"

	Make/D/O/N=(3) $"KVect"/wave=wKV
	wKV=K0*wZV

//	InitBasis(vModelK)
	wave wUM=$sModelP+"UMat"
	wave wVM=$sModelP+"VMat"
	wave wUpM=$sModelP+"UpMat"
	wave wVpM=$sModelP+"VpMat"
	wave wVpTM=$sModelP+"VpTMat"
	wave wUTM=$sModelP+"UTMat"
	wave wuvwzV=$sModelP+"uvwzVect"
	
	variable volp=MatrixDet(wUpM)

	Make/D/O/N=(3) $"gVect"/wave=wGV
	Make/D/O/N=(3) $"hklVect"/wave=whklV
	Make/D/O/N=(3) $"ruvwzVect"/wave=wRuvwzV
	
	Make/D/O/N=(3) $"hklpVect"/wave=whklpV

	getVect(wUM,wuvwzV,wRuvwzV)
	Variable H=1/norm(wRuvwzV)
	//Variable gHOLZmax=(2*K0*(Npzmax+0.5)*gz1)^0.5
	//Variable sgMin=gz1

//
	Variable nBeams=0
	wave whklM=$sSimP+"hklMat"
	Redimension/N=(0,3) whklM

	Make/D/O/N=(0) $sSimP+"magUVect"/WAVE=wMagUV

	variable/D magUhkl				
//add any reflections in suppMat
	wave wSupM=$sSimP+"supMat"
	variable nSup=DimSize(wSupM,0)

	variable i,j
	for(i=0;i<nSup;i+=1)
		whklV=wSupM[i][p]
		variable add_beam=1
		for(j=0;j<nBeams;j+=1)
			whklpV[]=whklM[j][p]
			if(AreEqual(whklV,whklpV))
				add_beam=0
			endif
		endfor
				
		if(add_beam)
			Redimension/N=(nBeams+1,3) whklM
			whklM[nBeams][]=whklV[q]

			Redimension/N=(nBeams+1) wMagUV
			wMagUV[nBeams]=magsqr(get_Uhkl_gen(E,whklV,wdCoordM,wSpcV,wOccV,wVM,volp))
			nBeams+=1
		endif
	endfor

	variable nFixedBeams=nBeams
					

	Make/D/O/N=(0,3) $sSimP+"rDelMat"/WAVE=wrDelM

	variable kxb=K0*(dxBeam)/camLen
	variable kyb=K0*(dyBeam)/camlen
	Make/D/O/N=(2) $"kDelVect"/WAVE=wkDelV,$"kbDelVect"/WAVE=wkbDelV
	wkbDelV[0]=kxb;wkbDelV[1]=kyb
	//variable H=1/sqrt(DotProd(uvwpzV,uvwpzV))

//find maxindex
	variable a1,a2,a3
	Make/D/O/N=(3) $"tempVect"/WAVE=wTempV
	Make/D/O/N=(3) $"mpVect"/WAVE=wMpV
	
	wMpV={1,0,0}	
	getVect(wUpM,wMpV,wTempV)
	a1=len(wTempV)

	wMpV={0,1,0}	
	getVect(wUpM,wMpV,wTempV)
	a2=len(wTempV)

	wMpV={0,0,1}	
	getVect(wUpM,wMpV,wTempV)
	a3=len(wTempV)

	variable gzmax=(Nmax+0.5)*H
	variable garg=1-(cos(alpha/1000)-gzmax/K0)^2
	gmax=K0
	if(garg>=0)
		variable gxmax=K0*(sin(alpha/1000)+sqrt(garg))
		gmax=sqrt(gxmax^2+gzmax^2)
	endif
	
	variable/D Np1max=ceil(gmax*a1)
	variable/D Np2max=ceil(gmax*a2)
	variable/D Np3max=ceil(gmax*a3)
	
	Make/D/O/N=(2) $"delRVect"/WAVE=wDelRV

//find 2-D basis	
	variable mp1,mp2,mp3
	for(mp3=-Np3max;mp3<=Np3max;mp3+=1)
		for(mp2=-Np2max;mp2<=Np2max;mp2+=1)
			for(mp1=-Np1max;mp1<=Np1max;mp1+=1)
				wMpV={mp1,mp2,mp3}	
				getVect(wVpM,wMpV,wGV)
				
				//check if zone is included				
				getVect(wUTM,wGV,whklV)
				whklV=round(whklV)
				variable N3=DotProd(whklV,wuvwzV)
				if((N3<Nmin)||(N3>Nmax))
					continue
				endif
				
			//Check if defect line is in (eccentric) circle
				GetDelRV(wGV,lambda,camlen,wRZoneV,wRBeamV,wPhiM,wEccM,0,wDelRV)
				if(!IsLineInCircle(wDelRV,wRBeamV[0],wRBeamV[1],rad))
					continue
				endif
				
				//check if already exists
				add_beam=1
				for(i=0;i<nFixedBeams;i+=1)
					whklpV=whklM[i][p]
					if(AreEqual(whklV,whklpV))
						add_beam=0
						break
					endif
				endfor
				if(!add_beam)
					continue
				endif
				
				IsLineInCircle(wDelRV,wRBeamV[0],wRBeamV[1],rad)
				magUhkl=magsqr(get_Uhkl_gen(E,whklV,wdCoordM,wSpcV,wOccV,wVM,volp))					
				variable iPos=nBeams
				for(i=nFixedBeams;i<nBeams;i+=1)
					if(magUhkl>wMagUV[i])
						iPos=i
						break
					endif
				endfor
						
				if(nBeams<max_lines)
					Redimension/N=(nBeams+1,3) whklM
					Redimension/N=(nBeams+1) wMagUV
					nBeams+=1
				endif

				for(i=nBeams-1;i>=iPos;i-=1)
					whklM[i+1][]=whklM[i][q]
					wMagUV[i+1]=wMagUV[i]
				endfor
							
				if(iPos<nBeams)					
					whklM[iPos][]=whklV[q]//
					wMagUV[iPos]=magUhkl
				endif
			endfor
		endfor	
	endfor
End

