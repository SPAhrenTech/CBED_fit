Function get_dE1(iModelK)
variable iModelK

	string sCnstnP="root:Constants:"

	if(GetObjectIndex(2,iModelK)<0)
		return -1
	endif
	string sModelP=GetObjectPath(2,iModelK)
	
	nvar vLayerK=$sModelP+"layerKey"	
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,vLayerK)

	nvar vMaterK=$sLayerP+"materKey"
	if(GetObjectIndex(13,vMaterK)<0)
		return -1
	endif
	string sMaterP=GetObjectPath(13,vMaterK)
	wave wMaterParV=$sMaterP+"parVal"
	nvar vMaterY=$sMaterP+"materType"
	wave wOccV=$sMaterP+"occVect"
	
	string sRootMaterTypeP=sCnstnP+"materTypes:"
	wave/T wMaterTypeT=$sRootMaterTypeP+"title"
	string sMaterTypeP=sRootMaterTypeP+wMaterTypeT[vMaterY]+":"
	wave wdCoordM=$sMaterTypeP+"dCoordMat"
	wave wSpcV=$sMaterTypeP+"spcVect"

	nvar vStructT=$sLayerP+"structType"

	nvar vBeamK=$sModelP+"beamKey"
	if(GetObjectIndex(0,vBeamK)<0)
		return -1
	endif
	string sBeamP=GetObjectPath(0,vBeamK)		

	wave wBeamParV=$sBeamP+"parVal"
	Variable E=wBeamParV[0]
	
	wave wModelInfoV=$sModelP+"infoVal"
	Variable dyn_corr=wModelInfoV[0]
	Variable gmax=wModelInfoV[1]
	Variable thresh=wModelInfoV[2]
	Variable max_beams=wModelInfoV[3]

	Variable lambda=get_wvln(E)
	Variable K0=1/lambda
	Make/D/O/N=(3) $"KVect"
	wave wKV=$"KVect"
	wave wXV=$sCnstnP+"xVect"
	wave wYV=$sCnstnP+"yVect"
	wave wZV=$sCnstnP+"zVect"
	wKV=K0*wZV

	Wave wuvwzV=$sModelP+"uvwzVect"

	Make/D/O/N=3 $"hklVect",$"gVect"
	wave whklV=$"hklVect"
	wave wGV=$"gVect"

	wave wUM=$sModelP+"UMat"
	wave wVM=$sModelP+"VMat"
	wave wUpM=$sModelP+"UpMat"
	wave wVpM=$sModelP+"VpMat"

	MatrixMultiply wUM,wuvwzV
	wave wMProd=M_product
	Variable H=norm(wMProd)//Laue zone spacing
	variable volp=MatrixDet(wUpM)

	wave whkl0M= $sModelP+"hkl0Mat"
	Variable nBeams=DimSize(whkl0M,0)

	Make/C/O/N=(nBeams,nBeams) $"AMat"
	wave/C wAM=$"AMat"
	
	Make/D/O/N=(3) $"hklVect",$"gVect",$"dhklVect"
	Wave whklV=$"hklVect"
	Wave wGV=$"gVect"
	Wave wdhklV=$"dhklVect"

	variable res=0//
	variable i,j
	for(i=0;i<nBeams;i+=1)
		whklV=whkl0M[i][p]
		getVect(wVM,whklV,wGV)
		wAM[i][i]=get_shkl(wKV,wGV)
		for(j=i+1;j<nBeams;j+=1)
			wdhklV[]=whkl0M[i][p]-whkl0M[j][p]					
			Variable/C Uhkl=get_Uhkl_gen(E,wdhklV,wdCoordM,wSpcV,wOccV,wVM,volp)
			Variable/C iXsi=Uhkl/K0
			wAM[i][j]=iXsi/2
			wAM[j][i]=conj(iXsi)/2
		endfor				
	endfor
	
	MatrixEigenV/R wAM
	wave wEigenV=W_eigenValues
	wave wEigenM=M_R_eigenVectors	

//Find eigen vector with largest mag(C0j)
	Variable gamm
	Variable largest_mag2C0j
	Variable ev_real
	Variable i_large=0
	for(i=0;i<nBeams;i+=1)
		Variable mag2C0j=magsqr(wEigenM[0][i])
		ev_real=real(wEigenV[i])
		if(i==0)
			largest_mag2C0j=mag2C0j
			gamm=ev_real
		endif
				
		if(mag2C0j>largest_mag2C0j)
			gamm=ev_real
			largest_mag2C0j=mag2C0j
		endif
	endfor

	NVAR mc2=$sCnstnP+"mc2"//KeV
	NVAR hc=$sCnstnP+"hc"//KeV.nm
	
	//Variable dE1=300*(K0/10)^2*(gamm/10)/(1+(1.956e-6)*(E*1000))/(H/10)/1000
	Variable dE1=gamm*hc^2*K0^2/H/(mc2+E)
	wave wCalcV=$sModelP+"calcVal"
	wCalcV[0]=dE1
	return dE1	
End


