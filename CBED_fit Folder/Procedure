Function GetRotationMatrix(wV,wVp)
wave wV,wVp
	
	string sRootConstP="root:Constants:"
	string sP="root:Heap:"
	
	wave wXV=$sRootConstP+"xVect"
	wave wYV=$sRootConstP+"yVect"
	wave wZV=$sRootConstP+"zVect"
	
	Make/D/O/N=(3) $sP+"aVect"/wave=wAV
	Make/D/O/N=(3) $sP+"bVect"/wave=wBV
	
	Make/D/O/N=(3,3) $sP+"aMat"/wave=wAM
	Make/D/O/N=(3,3) $sP+"bMat"/wave=wBM
	
//
	wAV[]=wV[p]
	Variable len=Norm(wAV)
	wAV/=len 
	wAM[][0]=wAV[p]

//
	Cross wV,wVp
	wave wCrossV=W_Cross
	wBV[]=wCrossV[p]
	len=Norm(wBV)
	if(len>0.)		
		wBV/=len
	else
		Cross wV,wYV
		wBV[]=wCrossV[p]
		len=Norm(wBV)
		if(len>0.)		
			wBV/=len
		else
			Cross wZV,wV
			wBV[]=wCrossV[p]
			len=Norm(wBV)
			wBV/=len
		endif
	endif
	wAM[][2]=wBV[p]

//
	wAV[]=wAM[p][0]
	wBV[]=wAM[p][2]
	Cross wBV,wAV
	wAM[][1]=wCrossV[p]

//
	wAV=wVp
	len=Norm(wAV)
	wAV/=len 
	wBM[][0]=wAV[p]

//
	wBM[][2]=wAM[p][2]

//
	wAV[]=wBM[p][0]
	wBV[]=wBM[p][2]
	Cross wBV,wAV
	len=Norm(wCrossV)
	wBM[][1]=wCrossV[p]/len
	
	MatrixInverse wAM
	wave wMInv=M_inverse

	MatrixMultiply wBM,wMInv
	Duplicate/O M_product,$sP+"M_result"
End

