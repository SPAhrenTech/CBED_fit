Function/C get_Uhkl_gen(E,whklV,wdCoordM,wSpcV,wOccV,wVM,primVol)
Variable E
wave whklV,wdCoordM,wSpcV,wOccV,wVM
variable primVol

	string sRootConstP="root:Constants:"
	string sEDiffP=sRootConstP+"eDiff:"

	NVAR mc2=$sRootConstP+"mc2"//KeV
	NVAR hc=$sRootConstP+"hc"//KeV.nm
	
	Make/D/O/N=(3) $"gVect"
	wave wgV=$"gVect"
	getVect(wVM,whklV,wgV)
	Variable s=Norm(wgV)/2
	Variable rel_corr=1+E/mc2
	
	Variable/C Fhkl=0
	variable nAtm=DimSize(wOccV,0)
	variable fAtm
	variable i
	for(i=0;i<nAtm;i+=1)
		fAtm=rel_corr*get_ffac(wSpcV[i],s)
		variable phase=2*pi*(whklV[0]*wdCoordM[i][0]+whklV[1]*wdCoordM[i][1]+whklV[2]*wdCoordM[i][2])
		Fhkl+=wOccV[i]*fAtm*cmplx(cos(phase),sin(phase))
	endfor
	
	variable atten=exp(-(s/40)^2)	
	Variable/C Uhkl=atten*Fhkl/pi/primVol
	return Uhkl
End

