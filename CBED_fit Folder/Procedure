Function GetRotationMatrixAngle(wV,wVp,angdeg)
wave wV,wVp
variable angdeg
	
	string sRootConstP="root:Constants:"
	string sP="root:Heap:"
	
	wave wXV=$sRootConstP+"xVect"
	wave wYV=$sRootConstP+"yVect"
	wave wZV=$sRootConstP+"zVect"
	
