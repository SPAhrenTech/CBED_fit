Function RegisterObject(iGroupK,sObjectT,makeDefault)
variable iGroupK
string sObjectT
variable makeDefault

	string sRootP="root:"
	string sRootGroupP=sRootP+"Group:"

	wave/T wGroupNameL=$sRootGroupP+"nameList"	
	wave wGroupKeyL=$sRootGroupP+"keyList"	
	wave/T wGroupRefL=$sRootGroupP+"refList"
	wave/T wGroupPrefixL=$sRootGroupP+"prefixList"
	wave wGroupDefKeyL=$sRootGroupP+"defkeyList"
	variable iGroup=FindIndex(iGroupK,wGroupKeyL)
	if(iGroup<0)
		return -1
	endif

	string sRootObjectP=sRootP+GetGroupName(iGroupK)+":"
	wave wObjectK=$sRootObjectP+"key"
	wave/T wObjectT=$sRootObjectP+"title"
 	Variable nObject=DimSize(wObjectK,0)
	Variable iObject=nObject
	Redimension/N=(nObject+1) wObjectT
	wObjectT[iObject]=sObjectT

	//Assign Key
	variable iObjectK=GetGroupNextkey(iGroupK)
	Redimension/N=(nObject+1) wObjectK
	wObjectK[iObject]=iObjectK

	return iObjectK
End

