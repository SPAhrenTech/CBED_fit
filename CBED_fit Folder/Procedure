			if(strsearch(sN,sPlotN,0)>=0)
				RemoveFromGraph/W=$sGraphN/Z $sN
			endif
			i=i+1
		while(1)	
	endif
	
	//indent here
	wave wDelrM=$sSimP+"delrMat"
	Variable nData=DimSize(wDelrM,0)

	wave whklM=$sSimP+"hklMat"

	string sWidthMatN=sPlotP+"widthMat"
	string sStyleMatN=sPlotP+"styleMat"
	string sColorMatN=sPlotP+"colorMat"

	//
	if((vS>1)||(!WaveExists($sWidthMatN)))
		Make/O/N=(nData) $sWidthMatN
	endif

	//
	if((vS>1)||(!WaveExists($sStyleMatN)))
		Make/O/N=(nData) $sStyleMatN
	endif

	if((vS>1)||(!WaveExists($sColorMatN)))
		Make/O/N=(nData,3) $sColorMatN
	endif
//
	wave wWidthM=$sWidthMatN
	wave wStyleM=$sStyleMatN
	wave wColorM=$sColorMatN
	
	if(vS>1)
		for(i=0;i<nData;i+=1)
			wWidthM[i]=iWidth
			wStyleM[i]=iStyle
			wColorM[i][0]=iRed
			wColorM[i][1]=iGreen
			wColorM[i][2]=iBlue
		endfor
	endif

	Make/D/O/N=(2) $"delRVect"/WAVE=wDelRV,$"delrVect"/WAVE=wDelkV	
	Make/D/O/N=(3) $"hklVect"/WAVE=whklV

	Variable yTop,xLeft,yBottom,xRight
	FindAxisRange(sGraphN,yTop,xLeft,yBottom,xRight)	
	
	Make/D/O/N=(2) $"rVect"/WAVE=wRV

	//string sXTempName=sPlotName+"_Tempx"
	//string sYTempName=sPlotName+"_Tempy"
	//Make/D/O/N=(2) $sPlotPath+sXTempName,$sPlotPath+sYTempName
