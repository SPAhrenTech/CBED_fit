Function IsGoodInitChar(c)
string c
	Variable cpos=char2num(c)
	if(((cpos>=char2num("A"))&&(cpos<=char2num("z"))))
		return 1
	endif
	return 0
End

//
Function IsGoodChar(c)
string c
	Variable cpos=char2num(c)
	if(((cpos>=char2num("A"))&&(cpos<=char2num("Z")))||((cpos>=char2num("a"))&&(cpos<=char2num("z")))||((cpos>=char2num("0"))&&(cpos<=char2num("9")))||(cpos==char2num("_")))
		return 1
	endif
	return 0
End
	
