Function DoZoomOutMarquee()

	string sPrevF=GetDataFolder(1)
	SetDataFolder $"root:Heap"

	string sRootP="root:"
	string sRootGraphP=sRootP+"Graphs:"

	string sGraphN=WinName(0,1)
	string sUserData=GetUserData(sGraphN,"","")
	variable iGraphK=str2num(sUserData)
	
	GetAxis/Q/W=$sGraphN left
	variable xGraphLeft=V_min,xGraphRight=V_max

	GetAxis/Q/W=$sGraphN bottom
	variable yGraphTop=V_max,yGraphBottom=V_min

	variable xGraphScale=(xGraphRight-xGraphLeft)
	variable yGraphScale=(yGraphTop-yGraphBottom)

	GetMarquee left, bottom	
	Variable xSelLeft=V_left,xSelRight=V_right
	Variable ySelTop=V_top,ySelBottom=V_bottom

	variable xSelScale=(xSelRight-xSelLeft)
	variable ySelScale=(ySelTop-ySelBottom)
	
	variable xCenter=(xSelLeft+xSelRight)/2
	variable yCenter=(ySelTop+ySelBottom)/2
	
	variable ratX=xGraphScale/xSelScale,ratY=yGraphScale/ySelScale
	variable rat=(ratX>ratY)?ratX : ratY
	
	variable xNewScale=rat*xGraphScale,yNewScale=rat*yGraphScale

	variable newScale=(xNewScale>yNewScale)? xNewScale : yNewScale//sqrt(xScale*yScale)
	variable new_yTop=yCenter+newScale/2,new_yBottom=yCenter-newScale/2
	variable new_xLeft=xCenter-newScale/2,new_xRight=xCenter+newScale/2
		
	SetAxis/W=$sGraphN left new_yBottom,new_yTop
	SetAxis/W=$sGraphN bottom new_xLeft,new_xRight
	
	SetDataFolder $sPrevF	
End

