Function FindObject(iObjectKey,objectK)
variable &iObjectKey
wave objectK

	variable nObject=DimSize(objectK,0)

	variable found_object=0
	variable iObject=FindIndex(iObjectKey,objectK)
	if(iObject<0)
		variable iObjectCheck=0
		do
			if(iObjectCheck<nObject)
				iObjectKey=objectK[iObjectCheck]
				iObject=FindIndex(iObjectKey,objectK)
				if(iObject<0)			
					iObjectCheck+=1
				else
					found_object=1
					break
				endif
			else
				break
			endif
		while(1)
	else
		found_object=1
	endif
	return iObject
end

