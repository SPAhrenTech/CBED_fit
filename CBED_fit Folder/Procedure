Variable xc,yc,rad

	Variable res=1
	Variable magDelr=norm(wDelRV)

	variable sthet=-wDelRV[0]/magDelr,cthet=wDelRV[1]/magDelr
	
	variable dist=xc*cthet+yc*sthet
	
	variable xn=-magDelr*sthet+dist*cthet
	variable yn=magDelr*cthet+dist*sthet
	
	variable s2=rad^2-((xn-xc)^2+(yn-yc)^2)
	
	if(s2<=0)
		res=0
	endif	
	return res
End

