Function FindZOLZReflection(uvwzV,hklV)
wave uvwzV
wave hklV

	string sP="root:Heap:"

	Make/D/O/N=(3) $sP+"hklBestVect"
	wave hklBestV=$sP+"hklBestVect"
	
	variable first=1,lenhklmin=1e8
	variable i,i0,i1,i2
	for(i=0;i<3;i+=1)
		i0=cyc(0+i,3);i1=cyc(1+i,3);i2=cyc(2+i,3)
		hklV[i0]=0;hklV[i1]=-uvwzV[i2];hklV[i2]=uvwzV[i1]
		variable lenhkl=norm(hklV)
		if(lenhkl>0)
			if(first)
				lenhklmin=lenhkl
				hklBestV=hklV[p]
				first=0
			else
				if(lenhkl<=lenhklmin)
					lenhklmin=lenhkl
					hklBestV=hklV[p]
				endif
			endif
		endif
	endfor
	hklV=hklBestV[p]
End		

Function ReducehklVector1(hklXV,hklYV)
wave hklXV,hklYV

	string sP="root:Heap:"

	Cross hklXV,hklYV
	wave wCross=W_cross
	Duplicate/O wCross,$sP+"temppVect"
	wave temppV=$sP+"temppVect"
	
	Factorize(temppV)
	
	variable nDot=DotProd(wCross,temppV)
	variable nFac=DotProd(temppV,temppV)
	variable nArea=nDot/nFac
	
	Duplicate/O hklYV,$sP+"hklpVect"
	wave hklpV=$sP+"hklpVect"
	hklpV=hklYV
	variable i
	for(i=0;i<nArea;i+=1)
		if((i!=0))
			temppV=(i*hklXV+1*hklYV)/nArea
			if(AreIntegers(temppV))
				hklpV=temppV
				break
			endif
		endif
	endfor	
	hklYV=hklpV
End
			
Function ReducehklVector2(hklXV,hklYV,hklZV)
wave hklXV,hklYV,hklZV

	string sP="root:Heap:"

	Cross hklXV,hklYV
	wave wCross=W_cross
	Duplicate/O wCross,$sP+"temppVect"
	wave temppV=$sP+"temppVect"
	variable nStep=DotProd(temppV,temppV)
	
	Duplicate/O hklYV,$sP+"hklpVect"
	wave hklpV=$sP+"hklpVect"
	hklpV=hklZV
	variable i,j
	for(i=0;i<nStep;i+=1)
		for(j=0;j<nStep;j+=1)
			if(!((i==0)&&(j==0)))
				temppV=(i*hklXV+j*hklYV+1*hklZV)/nStep
				if(AreIntegers(temppV))
					hklpV=temppV
					break
				endif
			endif	
		endfor
	endfor
	hklZV=hklpV
End
			
