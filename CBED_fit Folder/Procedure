	Variable iData
	for(iData=0;iData<nData;iData+=1)
		string sNum=GetKeyString(iData)
		string sXN=sPlotN+"_"+sNum+"x"
		string sYN=sPlotN+"_"+sNum+"y"

		variable is_new=(vS>1)||(!WaveExists($sPlotP+sXN))||(!WaveExists($sPlotP+sYN))		
		if(is_new)
			Make/D/O/N=(2) $sPlotP+sXN,$sPlotP+sYN
		endif
		
