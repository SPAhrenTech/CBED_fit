Function find_line_in_frame(wDelRV,yTop,xLeft,yBottom,xRight,wX,wY)
wave wDelRV
Variable yTop,xLeft,yBottom,xRight
wave wX,wY

	Variable res=1
	Variable magDelr=norm(wDelRV)

	Variable x0=xLeft,y0=(magDelr^2-wDelRV[0]*x0)/wDelRV[1]
	if(y0<yBottom)
		y0=yBottom;x0=(magDelr^2-wDelRV[1]*y0)/wDelRV[0]
		if((x0<xLeft)||(x0>xRight))
			res=0
		endif
	endif
	if(y0>yTop)
		y0=yTop;x0=(magDelr^2-wDelRV[1]*y0)/wDelRV[0]
		if((x0<xLeft)||(x0>xRight))
			res=0
		endif
	endif

	Variable x1=xRight,y1=(magDelr^2-wDelRV[0]*x1)/wDelRV[1]
	if(y1<yBottom)
		y1=yBottom;x1=(magDelr^2-wDelRV[1]*y1)/wDelRV[0]
		if((x1<xLeft)||(x1>xRight))
			res=0
		endif

	endif
	if(y1>yTop)
		y1=yTop;x1=(magDelr^2-wDelRV[1]*y1)/wDelRV[0]
		if((x1<xLeft)||(x1>xRight))
			res=0
		endif
	endif

	wX[0]=x0;wY[0]=y0
	wX[1]=x1;wY[1]=y1
	
	return res
End

