	variable alpha=wModelInfoV[6]

	nvar vLayerK=$sModelP+"layerKey"
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,vLayerK)

	nvar vMaterK=$sLayerP+"materKey"
	if(GetObjectIndex(13,vMaterK)<0)
		return -1
	endif
	string sMaterP=GetObjectPath(13,vMaterK)
	nvar vMaterY=$sMaterP+"materType"
	wave wdCoordM=$sModelP+"dCoordMat"
	wave wSpcV=$sModelP+"spcVect"
	wave wOccV=$sModelP+"occVect"

	nvar vStructY=$sLayerP+"structType"
	
	nvar vBeamK=$sModelP+"beamKey"
	if(GetObjectIndex(0,vBeamK)<0)
		return -1
	endif
	string sBeamP=GetObjectPath(0,vBeamK)
	
	wave wBeamParV=$sBeamP+"parVal"
	Variable E=wBeamParV[0]
	Variable lambda=get_wvln(E)
	Variable K0=1/lambda
	Make/D/O/N=(3) $"KVect"
	wave wKV=$"KVect"
	wave wXV=$sCnstnP+"xVect"
	wave wYV=$sCnstnP+"yVect"
	wave wZV=$sCnstnP+"zVect"
	wKV=-K0*wZV

	//InitBasis(iModelK)
	wave wUM=$sModelP+"UMat"
	wave wVM=$sModelP+"VMat"
	wave wUTM=$sModelP+"UTMat"
	wave wUpM=$sModelP+"UpMat"
	wave wVpM=$sModelP+"VpMat"
	wave wVpTM=$sModelP+"VpTMat"
	wave wuvwzV=$sModelP+"uvwzVect"

	Make/D/O/N=(3) $"gVect"/WAVE=wGV
	Make/D/O/N=(3) $"hklVect"/WAVE=whklV

	Make/D/O/N=(3) $"ruvwzVect"/WAVE=wRuvwzV
	getVect(wUM,wuvwzV,wRuvwzV)

//find 2-D basis	

	Make/D/O/N=(3) $"uvwpzVect"/WAVE=wuvwpzV

	getVect(wVpTM,wRuvwzV,wuvwpzV)
	Factorize(wuvwpzV)
	variable H=sqrt(DotProd(wuvwpzV,wuvwpzV))

	FindhklMatrix(wuvwpzV)
	Duplicate/O M_result,$"FMat"/WAVE=wFM

	MatrixInverse wFM
	Duplicate/O M_inverse,$"FIMat"/WAVE=wFIM

//
	Variable nBeams=0
	Make/O/N=(nBeams+1,3) $sModelP+"hkl0Mat"/WAVE=whkl0M
	whkl0M=0
	nBeams+=1

	variable volp=MatrixDet(wUpM)

	Make/D/O/N=(3) $"hklpVect"/WAVE=whklpV
	Make/D/O/N=(3) $"gVect"/WAVE=wG
		
	Make/D/O/N=(3) $"GxVect"/WAVE=wGxV
	Make/D/O/N=(3) $"GyVect"/WAVE=wGyVct

	Make/D/O/N=(3) $"gxVect"/WAVE=wGxV
	Make/D/O/N=(3) $"gyVect"/WAVE=wGyV

	Make/D/O/N=(3) $"XYZVect"/WAVE=wXYZV

	wXYZV={1,0,0}	
	MatrixMultiply wFM,wXYZV
	wave wMProd=M_product
	wGxV=wMProd
				
	wXYZV={0,1,0}	
	MatrixMultiply wFM,wXYZV
	wGyV=wMProd

	variable Nx,Ny
	variable Gzone=(0+1)*H*sqrt(2*K0/(0+1)/H-1)
	FindMaxIndices(Gzone,wGxV,wGyV,Nx,Ny)
	
	Make/D/O/N=(3) $"XYZVect"/WAVE=wXYZV
	variable mX,mY
	for(mY=-NY;mY<=NY;mY+=1)
		for(mX=-NX;mX<=NX;mX+=1)

			wXYZV={mX,mY,0}				
			MatrixMultiply wFM,wXYZV
			wave wMProd=M_product
			whklpV=wMProd

			getVect(wVpM,whklpV,wGV)
			variable g=norm(wGV)
			if((g>0)&&(g<gmax))				
					getVect(wUTM,wGV,whklV)
				Variable shkl=get_shkl(wKV,wGV)
				Variable/C Uhkl=get_Uhkl_gen(E,whklV,wdCoordM,wSpcV,wOccV,wVM,volp)					
				Variable/C iXsi=Uhkl/K0
				Variable crit=(magsqr(iXsi)^0.5)/abs(shkl)
				if(crit>thresh)//include beam
					if(nBeams+1>max_beams)
						Print("too many beams\r")
						return -1
					endif					
					Redimension/N=(nBeams+1,3) whkl0M
					whkl0M[nBeams][]=whklV[q]//
					nBeams+=1
				endif
			endif
		endfor
	endfor
End

