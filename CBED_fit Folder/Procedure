	variable iStyle=wPlotValL[1]
	variable iMarker=wPlotValL[2]
	variable iRed=wPlotValL[3]
	variable iGreen=wPlotValL[4]
	variable iBlue=wPlotValL[5]
	variable iShow=wPlotValL[6]
	variable iSize=wPlotValL[7]
	variable iReverse=wPlotValL[8]
	variable iBrightness=wPlotValL[9]
	variable iContrast=wPlotValL[10]
	variable iSubtype=wPlotValL[11]

