//Find the left pseudoinverse of matrix M
//The result is in M_result
//The return value is 1 is invertible, 0 if not invertible.
Function MatrixPseudoInverseLeft(wM)
wave wM
	Duplicate/O wM,M_temp
	MatrixTranspose M_temp	
	MatrixMultiply M_temp,wM

	Variable det=MatrixDet(M_product)
	Variable mtrace=MatrixTrace(M_product)
	Variable tol=1e-24//arbitrary factor, not based on any formal criteria
	Variable nSize=DimSize(wM,1)
	Variable tdet=abs(det)^(1/nSize)
	if((mtrace==0)||(numtype(mtrace!=0)))
		return 0
	endif
	if(abs(tdet/mtrace)<tol)
		return 0//not invertible
	endif

	MatrixInverse M_product	
	MatrixMultiply M_inverse,M_temp		

	Duplicate /O M_product,M_result
	KillWaves M_Temp
	return 1//inverted
end

//Find the right pseudoinverse of matrix M
//The result is in M_result
//The return value is 1 is invertible, 0 if not invertible.
Function MatrixPseudoInverseRight(wM)
wave wM

	Duplicate /O wM,M_temp
	MatrixTranspose M_temp	
	MatrixMultiply wM,M_temp

	Variable det=MatrixDet(M_product)
	Variable mtrace=MatrixTrace(M_product)
	Variable tol=1e-4//arbitrary factor
	Variable nSize=DimSize(wM,0)
	Variable tdet=abs(det)^(1/nSize)
	if((mtrace==0)||(numtype(mtrace!=0)))
		return 0
	endif
	if(abs(tdet/mtrace)<tol)
		return 0//not invertible
	endif

	MatrixInverse M_product	
	MatrixMultiply M_temp,M_inverse		
	Duplicate/O M_product,M_result
	KillWaves M_Temp

	return 1//inverted
end

