Function GetJM(wParV,wdParV,wJM)
Wave wParV,wdParV,wJM

	Variable nData=DimSize(wJM,0)
	Variable nPar=DimSize(wJM,1)

	Make/D/O/N=(nData) $"dFVect"/WAVE= wdFV
	
	Variable i
	for(i=0;i<nPar;i+=1)
		GetDFV(i,wParV,wdParV[i],wdFV)			
		wJM[][i]=wdFV[p]
	endfor
End

