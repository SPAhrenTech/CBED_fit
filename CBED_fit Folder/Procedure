Function UpdateHough(iHoughK,purgeFlag)
variable iHoughK
Variable purgeFlag

	if(GetObjectIndex(10,iHoughK)<0)
		return -1
	endif
	string sHoughP=GetObjectPath(10,iHoughK)
	string sHoughN=GetObjectName(10,iHoughK)

	variable iCoords=1

	if(iCoords)
		ModifyGraph/W=$sHoughN  noLabel=0
	else
		ModifyGraph/W=$sHoughN  noLabel=2
	endif	
	ModifyGraph/W=$sHoughN margin(left)=12+24*iCoords,margin(bottom)=12+24*iCoords,margin(right)=12,margin(top)=12

//
	wave wInfoV=$sHoughP+"infoVal"
	variable yTopR=wInfoV[0]
	variable xLeftR=wInfoV[1]
	variable yBottomR=wInfoV[2]
	variable xRightR=wInfoV[3]
	
	variable iRed=wInfoV[10]
	variable iGreen=wInfoV[11]
	variable iBlue=wInfoV[12]
	variable iMarker=wInfoV[13]
	variable iSize=wInfoV[14]

	variable sizeX=xRightR-xLeftR
	variable sizeY=yTopR-yBottomR
	variable x0=sizeX/2,y0=sizeY/2

	//
	wave wKeyL=$sHoughP+"keyList"

	//
	wave wrDelM=$sHoughP+"rDelMat"

	//
	string sTraceL,sN
	if(purgeFlag)
		//RemovePlot(iGraphKey,iPlotKey,0)
		sTraceL=TraceNameList(sHoughN,";",1)
		Variable i=0
		do
			sN=StringFromList(i,sTraceL)
			if(strlen(sN)==0)
				break
			endif
			if(strsearch(sN,sHoughN,0)>=0)
				RemoveFromGraph/W=$sHoughN/Z $sN
			endif
			i=i+1
		while(1)	

	endif

	string sColorMatN=sHoughP+"colorMat"
	string sMarkerMatN=sHoughP+"markerMat"
	string sSizeMatN=sHoughP+"sizeMat"

	variable nData=0
	nData=DimSize(rDelM,0)

	if(purgeFlag)
		Make/O/N=(nData,3) $sColorMatN
		Make/O/N=(nData) $sMarkerMatN
		Make/O/N=(nData) $sSizeMatN
	endif

	wave wColorM=$sColorMatN
	wave wMarkerM=$sMarkerMatN
	wave wSizeM=$sSizeMatN

	if(purgeFlag)
		for(i=0;i<nData;i+=1)
			wMarkerM[i]=iMarker
			wSizeM[i]=iSize
			wColorM[i][0]=iRed
			wColorM[i][1]=iGreen
			wColorM[i][2]=iBlue
		endfor
	endif

	Variable yTop,xLeft,yBottom,xRight
	FindAxisRange(sHoughN,yTop,xLeft,yBottom,xRight)	

	Make/D/O/N=(2) $"rVect"
	wave rV=$"rVect"
	string sPlotN="hough"
	Variable iData
	string sNum,sXN,sYN
	variable is_new
		sTraceL=TraceNameList(sHoughN,";",1)
		for(iData=0;iData<nData;iData+=1)
			sNum=GetKeyString(iData)
			sXN=sPlotN+"_"+sNum+"x"
			sYN=sPlotN+"_"+sNum+"y"

			is_new=purgeFlag||(!WaveExists($sHoughP+sXN))||(!WaveExists($sHoughP+sYN))		
			if(is_new)
				Make/D/O/N=(1) $sHoughP+sXN,$sHoughP+sYN
			endif	
			wave wX=$sHoughP+sXN
			wave wY=$sHoughP+sYN

			rV[]=wrDelM[iData][p]
			rV[0]-=x0;rV[1]-=y0;
			variable rad=len(rV)
			variable theta=asincos(rV[1]/rad,rV[0]/rad)
			
			wX[0]=theta;wY[0]=rad

			if(1)
				iRed=wColorM[iData][0]
				iGreen=wColorM[iData][1]
				iBlue=wColorM[iData][2]
				iMarker=wMarkerM[iData]
				iSize=wSizeM[iSize]
				if(strsearch(sTraceL,sYN,0)<0)
					AppendToGraph/W=$sHoughN wY vs wX
				endif
		
				ModifyGraph/W=$sHoughN mode($sYN)=3,marker($sYN)=iMarker,msize($sYN)=iSize
				ModifyGraph/W=$sHoughN mrkThick($sYN)=1,rgb($sYN)=(iRed,iGreen,iBlue)	
			endif
		endfor
End

