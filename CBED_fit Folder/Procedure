Function FoundBadGraph(iGraphK)
variable &iGraphK
	string sRootGraphP=GetRootObjectPath(8)

	Wave/T graphT=$sRootGraphP+"title"	
	wave graphK=$sRootGraphP+"key"

	Variable nGraph=DimSize(graphK,0)
	Variable iGraph
	for(iGraph=0;iGraph<nGraph;iGraph+=1)
		iGraphK=graphK[iGraph]
		string sGraphN=GetObjectName(8,iGraphK)
		string sGraphP=sRootGraphP+sGraphN+":"		

		string sWinList=WinList("*",";","WIN:1")	
		Variable found=0
		Variable i=0
		do
			string sName=StringFromList(i,sWinList)
			if(strlen(sName)==0)
				break
			endif
			if(strsearch(sName,sGraphN,0)>=0)
				found=1
				break
			endif
			i=i+1
		while(1)
		if(!found)
			return 1
		endif
	endfor
	return 0		
End

