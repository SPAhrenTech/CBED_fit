Function Find_hklV(iModelK,wDelrV,p_or_n,Nz,whklV)
variable iModelK
Wave wDelrV
Variable p_or_n,Nz
Wave whklV

	if(GetObjectIndex(2,iModelK)<0)
		return -1
	endif
	string sModelP=GetObjectPath(2,iModelK)

	wave wModelParV=$sModelP+"parVal"
	Variable L=wModelParV[0]
	Variable phi=wModelParV[1]
	Variable xc=wModelParV[2]
	Variable yc=wModelParV[3]
	Variable recc=wModelParV[4]
	Variable rho=wModelParV[5]

	wave wPhiIM=$sModelP+"phiIMat"
	wave wEccIM=$sModelP+"eccIMat"

	Make/D/O/N=(2) $"rcVect"/WAVE=wRcV
	wRcV={xc,yc}
	
	nvar vLayerK=$sModelP+"layerKey"
	if(GetObjectIndex(6,vLayerK)<0)
		return -1
	endif

	nvar vBeamK=$sModelP+"beamKey"
	if(GetObjectIndex(0,vBeamK)<0)
		return -1
	endif
	string sBeamP=GetObjectPath(0,vBeamK)		

	wave wBeamParV=$sBeamP+"parVal"
	variable E=wBeamParV[0]

	wave wModelInfoV=$sModelP+"infoVal"
	variable dyn_corr=wModelInfoV[0]
	variable xb=wModelInfoV[4]
	variable yb=wModelInfoV[5]
	variable alpha=wModelInfoV[6]

	Make/O/D/N=(2) $"rbVect"/WAVE=wRbV
	wRbV={xb,yb}

	wave wModelCalcV=$sModelP+"calcVal"
	Variable dE1=wModelCalcV[0]

	//transform
	Make/D/O/N=(2) $"delrpVect"/WAVE=wDelrpV
	wDelrpV=wDelrV
	
	TranslateDelN(wDelRpV,wRcV)
	TranslateDelN(wDelRpV,wRbV)
	TransformDel(wDelRpV,wEccIM)
	TranslateDel(wDelRpV,wRbV)
	TransformDel(wDelRpV,wPhiIM)
	
	//Scale to reciprocal space
	Make/D/O/N=(2) $"delkVect"/WAVE=wDelkV

	variable dE=0
	if(dyn_corr&&(abs(Nz)>0.5))
		dE=dE1/Nz
	endif
	Variable Ekin=E-dE
	variable lambda_kin=get_wvln(Ekin)

	wDelkV=wDelrpV/lambda_kin/L
	//Printf "delk: (%5.3f ,%5.3f) nm^-1\r",delkV[0],delkV[1]

	Variable delk=norm(wDelkV)
	Variable kxi=delk^2/wDelkV[0]
	Variable kyi=delk^2/wDelkV[1]
	
	//Printf "kxi,kyi: (%5.3f ,%5.3f) nm^-1\r",kxi,kyi
	Variable kz=1/lambda_kin

	//Find hkl
	wave wuvwzV=$sModelP+"uvwzVect"
	wave wUM=$sModelP+"UMat"

	Make/D/O/N=(3) $"ruvwzVect"/WAVE=wRuvwzV
	getVect(wUM,wuvwzV,wRuvwzV)

	Make/D/O/N=(3) $"gVect"/WAVE=wGV

	wave wUTM=$sModelP+"UTMat"

	Variable gz=Nz/norm(wRuvwzV)		
	wGV[2]=gz	
	Variable C=gz*kz-gz^2/2
	
//
	Variable gxy=p_or_n*delk+sqrt(delk^2+2*C)
	wGV[0]=(C-(gxy^2)/2)/kxi
	wGV[1]=(C-(gxy^2)/2)/kyi

	MatrixMultiply wUTM,wGV
	wave wMProd=M_Product
	whklV=wMProd
End


