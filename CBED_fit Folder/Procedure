Function FindhklMatrix(uvwpzV)
wave uvwpzV

	string sP="root:Heap:"

	Make/D/O/N=(3) $sP+"hklpXVect", $sP+"hklpYVect", $sP+"hklpZVect"
	wave hklpXV=$sP+"hklpXVect"
	wave hklpYV=$sP+"hklpYVect"
	wave hklpZV=$sP+"hklpZVect"

	FindZOLZReflection(uvwpzV,hklpXV)

	Cross uvwpzV,hklpXV
	wave wCross=W_cross
	hklpYV=wCross				

	//remove common factors
	Factorize(hklpXV)	
	Factorize(hklpYV)

	ReducehklVector1(hklpXV,hklpYV)

	hklpZV=uvwpzV
	ReducehklVector2(hklpXV,hklpYV,hklpZV)

	Make/D/O/N=(3,3) $sP+"M_result"
	wave wM_result=$sP+"M_result"
	wM_result[][0]=hklpXV[p]
	wM_result[][1]=hklpYV[p]
	wM_result[][2]=hklpZV[p]
	wM_result=round(wM_result)
End

