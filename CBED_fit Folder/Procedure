Function RefreshUpdateList(status)
variable status
	string sRootP="root:"
	string sRootUpdateP=sRootP+"Updates:"

	wave wGroupK=$sRootUpdateP+"groupKey"	
	wave wObjectK=$sRootUpdateP+"objectKey"
	//wave wLevelL=$sRootUpdateP+"levelList"
	
	variable nUpdate=DimSize(wGroupK,0)
	variable i
	for(i=0;i<nUpdate;i+=1)
		variable iGroupK=wGroupK[0]
		variable iObjectK=wObjectK[0]
		if(GetObjectIndex(iGroupK,iObjectK)<0)
			if(iObjectK==-1)
				DrawObjectPanel(iGroupK,0,1)
			endif
		else
			string sObjectP=GetObjectPath(iGroupK,iObjectK)
			nvar vS=$sObjectP+"status"
			if(status>vS)
				vS=status
			endif
			RefreshObject(iGroupK,iObjectK)
			if(vS>1)
				DrawObjectPanel(iGroupK,0,1)
			else
				DrawObjectPanel(iGroupK,0,0)
			endif	

			vS=0
		endif
		deletepoints 0,1,wGroupK,wObjectK//,wLevelL
	endfor
	ClearUpdateList()
End

