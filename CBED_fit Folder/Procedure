	string sGraphP=GetObjectPath(8,iGraphK)		

	nvar vPlotK=$sGraphP+"defPlotKey"
	if(GetObjectIndex(11,vPlotK)<0)
		return -1
	endif
	string sPlotP=GetObjectPath(11,vPlotK)			
	nvar vSourceY=$sPlotP+"sourceType"
	if(vSourceY==9)
		SetDynArea(vPlotK)
	endif

End

