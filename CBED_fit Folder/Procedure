	variable dxb=wModelInfoV[4]
	variable dyb=wModelInfoV[5]
	variable alpha=wModelInfoV[6]

	wave wRM=$sModelP+"PhiMat"	
	wave wRIM=$sModelP+"PhiIMat"	
	wave wEccM=$sModelP+"EccMat"	
	wave wEccIM=$sModelP+"EccIMat"	
	wave wEccITM=$sModelP+"EccITMat"	

	Make/O/D/N=(2) $"dRBeamVect"/WAVE=wdRBeamV,$"dnRBeamVect"/WAVE=wdnRBeamV
	//variable xc=L*sin(phiX/1000)
	//variable yc=L*sin(phiY/1000)
	wdRBeamV={dXb,dYb}
