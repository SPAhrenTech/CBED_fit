Function NewTable(iGroupK,iObjectK)
variable iGroupK,iObjectK

	string sRootObjectP=GetRootObjectPath(iGroupK)
	string sRootTableP=GetRootObjectPath(7)

	if(GetObjectIndex(iGroupK,iObjectK)<0)
		return -1
	endif

	string sObjectN=GetObjectName(iGroupK,iObjectK)
	string sObjectP=GetObjectPath(iGroupK,iObjectK)
	string sObjectT=GetObjectTitle(iGroupK,iObjectK)

	nvar vTableK=$sObjectP+"tableKey"

	wave/T wTableT=$sRootTableP+"title"
	wave wTableK=$sRootTableP+"key"

	variable new_table=0
	if(GetObjectIndex(7,vTableK)<0)
		vTableK=CreateObject(7)
		new_table=1
	endif
	SetObjectTitle(7,vTableK,sObjectT)
	
	string sTableN=GetObjectName(7,vTableK)
	string sTableP=GetObjectPath(7,vTableK)

	if(!new_table)
		string sWinList=WinList(sTableN,";","WIN:2")
		if(strlen(sWinList)>0)
			DoWindow/F $sTableN
		else
			new_table=1
		endif
	endif
	if(new_table)
		nvar vSourceY=$sTableP+"sourceType"	
		nvar vSourceK=$sTableP+"sourceKey"	
		vSourceY=iGroupK//group
		vSourceK=iObjectK
		string sTableInfo=GetKeyString(vTableK)

		Edit/K=1/N=$sTableN as sObjectT
		SetWindow $sTableN,userdata(table)=sTableInfo
		SetWindow $sTableN,hook(table)=TableWindowHook
		
		wave/T wTableNameL=$sRootObjectP+"tableNameList"
		wave wTableClassL=$sRootObjectP+"tableClassList"
		
		variable nWaves=DimSize(wTableNameL,0)		
		string sFullWaveN
		variable i
		for(i=0;i<nWaves;i+=1)
			switch(wTableClassL[i])
				case 1:
				sFullWaveN=sObjectP+wTableNameL[i]
				break

				default:
				sFullWaveN=sRootObjectP+wTableNameL[i]
				break
				
			endswitch
				
			AppendToTable/W=$sTableN $sFullWaveN
		endfor		
	endif
	SetGroupDefkey(7,vTableK)
	DrawAllPanels()

End

