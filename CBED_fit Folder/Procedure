Function get_comp_x_GaInPAs(a1,a2,a3,yc)
Variable a1,a2,a3,yc
	
	Variable xc=0.5
	variable tol=1e-5,maxiter=1000

	Variable apara=(a1+a2)/2;
	Variable aperp=a3;
	
	variable a0y=get_a_nm_GaInPAs(0,yc)
	variable a1y=get_a_nm_GaInPAs(1,yc)
	
	Variable i
	for(i=0;i<=maxiter;i+=1)	
		variable xc0=xc
		Variable C=get_crat_GaInPAs(xc,yc)
		Variable ap=(aperp+C*apara)/(1.+C)
		xc=(ap-a0y)/(a1y-a0y)
		if(abs(xc-xc0)<tol) 
			return xc
		endif
	endfor
	
	return xc
End

