Function AdjustImage(iPlotK,vBright,vCont,iReverse)
variable iPlotK
variable vBright,vCont,iReverse

	if(GetObjectIndex(11,iPlotK)<0)
		return -1
	endif
	string sPlotP=GetObjectPath(11,iPlotK)
	string sPlotN=GetObjectName(11,iPlotK)

	nvar vGraphK=$sPlotP+"graphKey"
	if(GetObjectIndex(8,vGraphK)<0)
		return -1
	endif
	string sGraphP=GetObjectPath(8,vGraphK)
	string sGraphN=GetObjectName(8,vGraphK)

	nvar vSourceY=$sPlotP+"sourceType"
	switch(vSourceY)
		case 5://image
		case 9://dyn
	
	//	variable iImageKey=plotKeyL[0]
	//	string sImageName="i"+GetKeyString(iImageKey)
		//wave wImage=$sRootImagePath+sImageName+":image"
		string sImageN=sPlotN
		wave wImage=$sPlotP+sPlotN
	
		ImageStats/M=1 wImage
		variable vMax=V_max+0.0001
		variable vMin=V_min-0.0001
		variable vAvg=(vMax+vMin)/2
		variable vDiff=(vMax-vMin)/2
	
		variable vAvg_p=vMin+(1-vBright)*vMax
		variable vDiff_p=2*(1-vCont)*vDiff

		variable vMax_p=vAvg_p+vDiff_p
		variable vMin_p=vAvg_p-vDiff_p
		
		if(iReverse)
			ModifyImage/W=$sGraphN $sImageN,ctab={vMax_p,vMin_p,Grays,0}
		else
			ModifyImage/W=$sGraphN $sImageN,ctab={vMin_p,vMax_p,Grays,0}
		endif
		break
	
		default:
		return -1
	endswitch
End

