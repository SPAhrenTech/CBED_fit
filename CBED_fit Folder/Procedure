Function RefreshLayer(iLayerK)
variable iLayerK

	string sRootCnstnP="root:Constants:"
	string sRootMaterTypeP=sRootCnstnP+"materTypes:"
	string sRootMaterPropP=sRootCnstnP+"materProps:"
	
	if(GetObjectIndex(6,iLayerK)<0)
		return -1
	endif
	string sLayerP=GetObjectPath(6,iLayerK)
	nvar vS=$sLayerP+"status"
	nvar vStructY=$sLayerP+"structType"

	wave/T wParL=$sLayerP+"parLabel"
	wave wParV=$sLayerP+"parVal"
	wave wParD=$sLayerP+"parDel"
	wave wParH=$sLayerP+"parHold"
	wave wParS=$sLayerP+"parStep"
	wave wParO=$sLayerP+"parTol"

	wave/T wInfoL=$sLayerP+"infoLabel"
	wave wInfoV=$sLayerP+"infoVal"
	variable phimDeg=wInfoV[0]//offcut angle
	variable is_symm=wInfoV[1]//in-plane symmetry
	variable no_shear=wInfoV[2]//no shear strain
	variable T_K=wInfoV[3]//T(K)

	nvar vMaterK=$sLayerP+"materKey"
	if(GetObjectIndex(13,vMaterK)<0)
		return -1
	endif
	string sMaterP=GetObjectPath(13,vMaterK)
	wave wMaterParV=$sMaterP+"parVal"
	nvar vMaterY=$sMaterP+"materType"
	wave wMaterInfoV=$sMaterP+"infoVal"
	variable alphaT=wMaterInfoV[1]
	wave wC0M=$sMaterP+"CMat"
	wave wA0M=$sMaterP+"AMat"
	
	wave wAM=$sLayerP+"AMat",wBM=$sLayerP+"BMat"
	wave wApM=$sLayerP+"ApMat",wBpM=$sLayerP+"BpMat"

	Variable a0,b0,c0
	Variable alpha0,beta0,gamma0
	wave wXV=$sRootCnstnP+"xVect"
	wave wYV=$sRootCnstnP+"yVect"
	wave wZV=$sRootCnstnP+"zVect"

	//Rotate to specified orientation for deformation
	wAM=wA0M*(1+alphaT*(T_K-300))
	
	wave wuvwzV=$sLayerP+"uvwzVect"
	Make/D/O/N=(3) $sLayerP+"zaxisVect"/WAVE=wzAxisV
	MatrixMultiply wAM,wuvwzV
	wave wMProd=M_product
	wzAxisV=wMProd		
	RotateBasis(wAM,wzAxisV,wZV)
	//[uvw] will be along z axis	
	
	//Find reciprocal basis
	MatrixInverse wAM
	MatrixTranspose M_Inverse
	wave wMInv=M_Inverse
	wBM=wMInv

	//Orient x axis
	wave whklxV=$sLayerP+"hklxVect"
	Make/D/O/N=(3) $sLayerP+"xAxisVect"/WAVE=wxAxisV
	MatrixMultiply wBM,whklxV
	wave wMProd=M_product
	wxAxisV=wMProd
	Make/D/O/N=(3) $sLayerP+"XpV"/WAVE=wXpV
	FindNormalVect(wZV,wxAxisV,wXpV)
	if(Norm(wXpV)>0)
		RotateBasis(wAM,wXpV,wXV)
	endif
	//[uvw] will be along z-axis; (hkl) will be in x-z plane.
	
	//Rotate by misorientation angle
	wave whklmV=$sLayerP+"hklmVect"
	Make/D/O/N=(3) $sLayerP+"tiltVect"/WAVE=wTiltV
	MatrixMultiply wBM,whklmV
	wave wMProd=M_product
	wTiltV=wMProd
	if(Norm(wTiltV)>0)
		RotateBasisAngle(wAM,wzAxisV,wTiltV,phimDeg)
	endif
	//[uvw] will be along z-axis; (hkl) will be along x axis.
	
	//Find rotation matrix
	Make/D/O/N=(3,3) $sLayerP+"TMat"/wave=wTM//rotation matrix
	MatrixInverse wA0M
	wave wInvM=M_Inverse
	MatrixMultiply wAM,wInvM
	wave wMProd=M_product
	wTM=wMProd
	
	//Find rotated elasticity matrix
	Make/D/O/N=(3,3,3,3) $sLayerP+"CMat"/wave=wCM
	wCM[][][][]=wC0M[p][q][r][s]
	RotateElastMat(wCM,wTM)
	
	//Change to reduced form
	Make/D/O/N=(6,6) $sLayerP+"C2DMat"/wave=wC2DM
	variable m,n
	variable, i,j,k,l
	for(m=0;m<6;m+=1)
		get_reduced_pair(m,i,j)
		for(n=0;n<6;n+=1)
			get_reduced_pair(n,k,l)				
			wC2DM[m][n]=wCM[i][j][k][l]
		endfor
	endfor
	
	
	//List of zero-stress components
	Make/U/O/N=(0) $sLayerP+"freeList"/wave=wFreeL

	//Assume no symmetry
	variable nEps=6
	Make/D/O/N=(6,nEps) $sLayerP+"epsVectL"/wave=wEpsVectL
	wEpsVectL[][]=(p==q)?1:0

//
	if(vS>0)
		switch(vStructY)
			case 0://unstrained
			Redimension/N=(6) wFreeL
			wFreeL={0,1,2,3,4,5}
			break
	
			case 1://uniaxial
			Redimension/N=(5) wFreeL
			wFreeL={0,1,3,4,5}
			break

			case 2://biaxial
			Redimension/N=(3) wFreeL
			wFreeL={2,3,4}
			break

			case 3://triaxial
			Redimension/N=(0) wFreeL
			break
			
		endswitch
	endif
	
	//Enforce stress field symmetry
	variable nFree=DimSize(wFreeL,0)
	if(nFree>0)
		nEps=0
		Make/D/O/N=(nFree,6) $sLayerP+"CRedMat"/wave=wCRedM
		for(i=0;i<nFree;i+=1)
			wCRedM[i][]=wC2DM[wFreeL[i]][q]
		endfor
	
		MatrixMultiply wCRedM/T,wCRedM
		wave wMProd=M_product
	
		//variable det=MatrixDet(wMProd)
	
		MatrixEigenV/O/R/EVEC wMProd
		wave wEigenVal=W_eigenValues
		wave wEigenVectM=M_R_eigenVectors
		
		variable stress_thresh=1.e-4
		for(i=0;i<6;i+=1)
			if(sqrt(magsqr(wEigenVal[i]))<stress_thresh)
				Redimension/N=(6,nEps+1) wEpsVectL
				wEpsVectL[][nEps]=wEigenVectM[p][i]
				nEps+=1
			endif
		endfor
	endif
	
	
	//Enforce in-plane symmetry
	variable symm_thresh=1.e-4,nEpsp=0
	if(is_symm)
		Make/D/O/N=(6,6) $sLayerP+"SymmMat"/wave=wSymmM
		wSymmM[][]=(p==q)?1.:0.
		wSymmM[][1]=(p==0)?1.:0.
		wSymmM[][0]=(p==1)?1.:0.
		//wSymmM[][4]=(p==3)?1.:0.
		//wSymmM[][3]=(p==4)?1.:0.
		
		wSymmM[][]-=(p==q)?1.:0.
		MatrixMultiply wSymmM,wEpsVectL
		wave wMProd=M_product
		
		MatrixMultiply wMProd/T,wMProd
		wave wMProd=M_product
	
		MatrixEigenV/O/R/EVEC wMProd
		wave wEigenValp=W_eigenValues
		wave wEigenVectMp=M_R_eigenVectors
		MatrixMultiply wEpsVectL,wEigenVectMp
		wave wMprod=M_product
		Make/D/O/N=(6,0) $sLayerP+"epsVectpL"/wave=wEpsVectpL
		for(i=0;i<nEps;i+=1)
			if(sqrt(magsqr(wEigenValp[i]))<symm_thresh)
				Redimension/N=(6,nEpsp+1) wEpsVectpL
				wEpsVectpL[][nEpsp]=wMprod[p][i]
				nEpsp+=1
			endif
		endfor
		Duplicate/O wEpsVectpL,$sLayerP+"epsVectL"/wave=wEpsVectL
		nEps=nEpsp
	endif
			
	//Enforce no shear strain
	nEpsp=0
	if(no_shear)
		Make/D/O/N=(6,6) $sLayerP+"SymmMat"/wave=wSymmM
		wSymmM[][]=((p==q)&&(p<3))?1.:0.		
		wSymmM[][]-=(p==q)?1.:0.
		MatrixMultiply wSymmM,wEpsVectL
		wave wMProd=M_product
		
		MatrixMultiply wMProd/T,wMProd
		wave wMProd=M_product
	
		MatrixEigenV/O/R/EVEC wMProd
		wave wEigenValp=W_eigenValues
		wave wEigenVectMp=M_R_eigenVectors
		MatrixMultiply wEpsVectL,wEigenVectMp
		wave wMprod=M_product
		Make/D/O/N=(6,0) $sLayerP+"epsVectpL"/wave=wEpsVectpL
		for(i=0;i<nEps;i+=1)
			if(sqrt(magsqr(wEigenValp[i]))<symm_thresh)
				Redimension/N=(6,nEpsp+1) wEpsVectpL
				wEpsVectpL[][nEpsp]=wMprod[p][i]
				nEpsp+=1
			endif
		endfor
		Duplicate/O wEpsVectpL,$sLayerP+"epsVectL"/wave=wEpsVectL
		nEps=nEpsp
	endif
			
	//test
	Matrixmultiply wC2DM,wEpsVectL
	wave wMProd=M_product
	Duplicate/O wMProd,$sLayerP+"sigVectL"/wave=wSigVectL
	
	
	//create parameters, if needed
	variable nEpsPrev=DimSize(wParL,0)
	if((vS>2)||(nEps!=nEpsPrev))
		Redimension/N=(nEps) wParL,wParV,wParD,wParH,wParO
		wParL="coef";wParV=0.;wParD=0;wParH=0;wParO=1e-9
	endif
	
	if(nEps>0)
		wave wEpsV=$sLayerP+"epsVect"
		wave wdEpsV=$sLayerP+"depsVect"

		//extract parameters from existing strain vector
		if(vS>1)
			MatrixPseudoInverseLeft(wEpsVectL)
			wave wMres=M_result
			MatrixMultiply wMres,wEpsV
			wave wMProd=M_product
			wParV=wMProd
		endif
	
		//Get strain vector
		MatrixMultiply wEpsVectL,wParV
		wave wMProd=M_product
		wEpsV=wMProd
		
		//Get del strain vector (coherent)
		//MatrixMultiply wEpsVectL,wParD
		//wave wMProd=M_product
		//wdEpsV=wMProd
	
		//Get del strain vector (incoherent)
		wdEpsV=0
		for(i=0;i<nEps;i+=1)
			wdEpsV[]+=(wParD[i]*wEpsVectL[p][i])^2
		endfor
		wdEpsV=sqrt(wdEpsV)
	
		//Get deformation matrix
		Make/D/O/N=(3,3) $sLayerP+"deforMat"/wave=wDeforM
		wave wijLU1=$sRootMaterPropP+"ijlookup1"
		wDeforM[][]=((p==q)?1:0)+((p==q)?1:0.5)*wEpsV[wijLU1[p][q]]

		//Apply deformation
		MatrixMultiply wDeforM,wAM
		wave wMProd=M_product
		wAM=wMProd
	endif
	
	//Find primitive basis
	wave/T wMaterTypeT=$sRootMaterTypeP+"title"
	string sMaterTypeN=wMaterTypeT[vMaterY]
	string sMaterTypeP=sRootMaterTypeP+sMaterTypeN+":"

	wave wPrimTM=$sMaterTypeP+"primTMat"
	MatrixMultiply wAM,wPrimTM
	wave wMProd=M_product
	wApM=wMProd

	//Find reciprocal basis
	
	//wBM=wAM
	MatrixInverse wAM
	MatrixTranspose M_Inverse
	wave wMInv=M_Inverse
	wBM=wMInv

	//Find primitive reciprocal basis
	MatrixInverse wApM
	MatrixTranspose M_Inverse
	wave wMInv=M_Inverse
	wBpM=wMInv
	
	//Test
	MatrixInverse wTM
	wave wInvM=M_Inverse
	MatrixMultiply wInvM,wAM
	wave wMProd=M_product
	Duplicate/O wMProd,$sLayerP+"AMod"/wave=wAMod
End

