Function Factorize(V)
wave V

	Duplicate/O V,tempVect
	wave tempV=tempVect
	variable nElem=DimSize(V,0)
	variable fac,i
	do
		tempV=abs(V)
		Sort/R tempV,tempV
		variable facMax=tempV[0]	
		variable isFac=0
		for(fac=facMax;fac>1;fac-=1)
			tempV=V/fac
			isFac=1
			for(i=0;i<nElem;i+=1)
				if(!IsInteger(tempV[i]))
					isFac=0
					break
				endif
			endfor
			if(isFac)
				V/=fac
				break
			endif
		endfor
		tempV=abs(V)
	while(isFac)
End

