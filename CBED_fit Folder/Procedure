Function RemovePlot(iPlotK)
variable iPlotK

	if(GetObjectIndex(11,iPlotK)<0)
		return -1
	endif
	string sPlotP=GetObjectPath(11,iPlotK)
	string sPlotN=GetObjectName(11,iPlotK)

	nvar vGraphK=$sPlotP+"graphKey"
	if(GetObjectIndex(8,vGraphK)<0)
		return -1
	endif
	string sGraphP=GetObjectPath(8,vGraphK)
	string sGraphN=GetObjectName(8,vGraphK)

	Variable i=0
	string sN
	nvar vSourceY=$sPlotP+"sourceType"	
	nvar vSourceK=$sPlotP+"sourceKey"	
	switch(vSourceY)
		case -1:
		case 1:
		case 2:
		case 3:
		case 4:

		string sTraceL=TraceNameList(sGraphN,";",1)
		do
			sN=StringFromList(i,sTraceL)
			if(strlen(sN)==0)
				break
			endif
			if(strsearch(sN,sPlotN,0)>=0)
				RemoveFromGraph/W=$sGraphN/Z $sN
			endif
			i+=1
		while(1)	
		break
		
		case 5://image
		case 9://dyn
		string sImageL=ImageNameList(sGraphN,";")
		do
			sN=StringFromList(i,sImageL)
			if(strlen(sN)==0)
				break
			endif
			if(strsearch(sN,sPlotN,0)>=0)
				RemoveImage/W=$sGraphN/Z $sN
			endif
			i+=1
		while(1)	
		break

	endswitch
	RemoveObjectRef(vSourceY,vSourceK,11,iPlotK)

End

