	wave wEventGroupK=$sRootEventP+"eventGroupKey"
	wave wEventObjectK=$sRootEventP+"eventObjectKey"
	wave wEventC=$sRootEventP+"eventCode"
	
	variable nEvents=DimSize(wEventGroupK,0)
	variable i
	for(i=0;i<nEvents;i+=1)
		if((wEventGroupK[i]==iGroupK)&&(wEventObjectK[i]==iObjectK)&&(wEventC[i]==eventCode))
